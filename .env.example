# ============================================================
# LMS BACKEND ENVIRONMENT VARIABLES
# ============================================================

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://lms:lms_password@localhost:5432/lms_db?schema=public"

# ─── Authentication ────────────────────────────────────────────
JWT_SECRET="enterprise_super_secret_access_67890!#"   
JWT_EXPIRES_IN=1d

# ─── Auth Service Client ──────────────────────────────────────
AUTH_SERVICE_URL="http://localhost:5000"
AUTH_CLIENT_ID="lms-service"
AUTH_CLIENT_SECRET="lms_dev_secret"

# ─── EMS Service (Employee Management System) ─────────────────────────────
# Used by the Access Control UI to show real EMS role names in the mapping
# dropdown. Optional — when unset the picker falls back to manual entry.
EMS_SERVICE_URL="http://localhost:5001"  

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_URL="amqp://guest:guest@localhost:5672"
RABBITMQ_EXCHANGE=lms.events
RABBITMQ_QUEUE=lms.queue

# ─── Cloud Storage ─────────────────────────────────────────────
CLOUD_PROVIDER=aws
AWS_REGION=us-east-1
AWS_BUCKET_NAME=lms-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Swagger ──────────────────────────────────────────────────
SWAGGER_ENABLED=true

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── CORS ──────────────────────────────────────────────────────
CLIENT_URL="http://localhost:5173"

# ─── Internal API ──────────────────────────────────────────────
INTERNAL_API_KEY="your-super-secret-internal-key-here"
REDIS_URL="redis://localhost:6379"
