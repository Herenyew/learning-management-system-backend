///////////////////////////////////////////////////////////
// LEARNING PROGRAMS
///////////////////////////////////////////////////////////

model LearningProgram {
  id                Int                   @id @default(autoincrement())
  companyId         Int
  name              String                @db.VarChar(255)
  description       String?               @db.Text
  programTypeId     Int
  ownerEmployeeId   String                @db.VarChar(20)
  visibility        VisibilityType
  status            LearningProgramStatus
  startDate         DateTime?
  endDate           DateTime?
  durationDays      Int?
  rollingEnrollment Boolean               @default(false)
  maxEnrollments    Int?
  approvalStatus    ApprovalStatus

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company       Company     @relation(fields: [companyId], references: [id])
  programType   ProgramType @relation(fields: [programTypeId], references: [id])
  owner         Employee    @relation(fields: [ownerEmployeeId], references: [id])
  createdByUser AppUser     @relation("ProgramCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser?    @relation("ProgramUpdatedBy", fields: [updatedBy], references: [id])

  courses             ProgramCourse[]
  cohorts             ProgramCohort[]
  enrollments         ProgramEnrollment[]
  milestones          ProgramMilestone[]
  tasks               ProgramTask[]
  tnaRecommendations  TnaRecommendation[]
  enrollmentRules     EnrollmentRule[]           @relation("EnrollmentRuleProgram")
  certificateTemplate CertificateTemplate?
  approvalInstances   ApprovalWorkflowInstance[]
  xpRules             XpRule[]

  targetAudiences TargetAudience[]

  programCategoryId Int?
  programCategory   ProgramCategory? @relation(fields: [programCategoryId], references: [id])
  liveSessions      LiveSession[]

  @@index([companyId])
  @@map("learning_programs")
}

model ProgramType {
  id          Int               @id @default(autoincrement())
  companyId   Int
  name        String            @db.VarChar(100)
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id])
  programs    LearningProgram[]

  @@unique([companyId, name])
  @@map("program_types")
