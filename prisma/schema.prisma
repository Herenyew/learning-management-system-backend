model Bookmark {
  id         Int       @id @default(autoincrement())
  companyId  Int
  employeeId String    @db.VarChar(20)
  courseId   Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  company    Company   @relation(fields: [companyId], references: [id])
  employee   Employee  @relation(fields: [employeeId], references: [id])
  course     Course    @relation(fields: [courseId], references: [id])

  @@unique([employeeId, courseId])
  @@index([companyId])
  @@map("bookmarks")
}

model CourseReview {
  id              Int              @id @default(autoincrement())
  companyId       Int
  completionId    Int              @unique
  courseId        Int
  rating          Int
  reviewTitle     String?          @db.VarChar(255)
  reviewText      String?          @db.Text
  isAnonymous     Boolean          @default(false)
  isPublished     Boolean          @default(true)
  moderatedBy     Int?
  moderatedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  company         Company          @relation(fields: [companyId], references: [id])
  completion      CourseCompletion @relation(fields: [completionId], references: [id])
  course          Course           @relation(fields: [courseId], references: [id])
  moderatedByUser AppUser?         @relation(fields: [moderatedBy], references: [id])

  @@index([companyId])
  @@index([courseId])
  @@index([rating])
  @@map("course_reviews")
}

model RelatedCourse {
  id              Int      @id @default(autoincrement())
  companyId       Int
  courseId        Int // Main course
  relatedCourseId Int // Recommended course
  relationType    String   @db.VarChar(50) // "PREREQUISITE", "NEXT", "SIMILAR", "RECOMMENDED"
  reason          String?  @db.Text // Optional: "Users who completed X also did Y"
  weight          Decimal? @db.Decimal(5, 2) // For ranking recommendations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company @relation(fields: [companyId], references: [id])
  course        Course  @relation("CourseRelations", fields: [courseId], references: [id])
  relatedCourse Course  @relation("RelatedTo", fields: [relatedCourseId], references: [id])

  @@unique([courseId, relatedCourseId])
  @@index([companyId])
  @@map("related_courses")
}

model CourseFAQ {
  id              Int  @id @default(autoincrement())
  companyId       Int
  courseId        Int
  courseVersionId Int?

  question     String  @db.VarChar(500)
  answer       String  @db.Text
  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  course        Course         @relation(fields: [courseId], references: [id])
  courseVersion CourseVersion? @relation(fields: [courseVersionId], references: [id])
  createdByUser AppUser        @relation("CourseFAQCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser?       @relation("CourseFAQUpdatedBy", fields: [updatedBy], references: [id])

  @@index([companyId])
  @@index([courseId])
  @@index([courseVersionId])
  @@map("course_faqs")
}

///////////////////////////////////////////////////////////
// LEARNING PROGRAMS
///////////////////////////////////////////////////////////

model LearningProgram {
  id                Int                   @id @default(autoincrement())
  companyId         Int
  name              String                @db.VarChar(255)
  description       String?               @db.Text
  programTypeId     Int
  ownerEmployeeId   String                @db.VarChar(20)
  visibility        VisibilityType
  status            LearningProgramStatus
  startDate         DateTime?
  endDate           DateTime?
  durationDays      Int?
  rollingEnrollment Boolean               @default(false)
  maxEnrollments    Int?
  approvalStatus    ApprovalStatus

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company       Company     @relation(fields: [companyId], references: [id])
  programType   ProgramType @relation(fields: [programTypeId], references: [id])
  owner         Employee    @relation(fields: [ownerEmployeeId], references: [id])
  createdByUser AppUser     @relation("ProgramCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser?    @relation("ProgramUpdatedBy", fields: [updatedBy], references: [id])

  courses             ProgramCourse[]
  cohorts             ProgramCohort[]
  enrollments         ProgramEnrollment[]
  milestones          ProgramMilestone[]
  tasks               ProgramTask[]
  tnaRecommendations  TnaRecommendation[]
  enrollmentRules     EnrollmentRule[]           @relation("EnrollmentRuleProgram")
  certificateTemplate CertificateTemplate[]
  approvalInstances   ApprovalWorkflowInstance[]
  xpRules             XpRule[]

  programCategoryId  Int?
  programCategory    ProgramCategory?    @relation(fields: [programCategoryId], references: [id])
  liveSessions       LiveSession[]
  programTagMappings ProgramTagMapping[]

  @@index([companyId])
  @@map("learning_programs")
}

model ProgramType {
  id          Int               @id @default(autoincrement())
  companyId   Int
  name        String            @db.VarChar(100)
  description String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  company     Company           @relation(fields: [companyId], references: [id])
  programs    LearningProgram[]

  @@unique([companyId, name])
  @@map("program_types")
}

model ProgramCategory {
  id          Int               @id @default(autoincrement())
  companyId   Int
  name        String            @db.VarChar(100)
  description String?           @db.Text
  color       String?           @db.VarChar(20)
  isActive    Boolean           @default(true)
  createdBy   Int
  updatedBy   Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  company     Company           @relation(fields: [companyId], references: [id])
  creator     AppUser           @relation("ProgramCategoryCreator", fields: [createdBy], references: [id])
  updater     AppUser?          @relation("ProgramCategoryUpdater", fields: [updatedBy], references: [id])
  programs    LearningProgram[]
  templates   ProgramTemplate[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("program_categories")
}

model ProgramCourse {
  id              Int             @id @default(autoincrement())
  companyId       Int
  programId       Int
  courseVersionId Int
  displayOrder    Int
  isRequired      Boolean         @default(true)
  company         Company         @relation(fields: [companyId], references: [id])
  program         LearningProgram @relation(fields: [programId], references: [id])
  courseVersion   CourseVersion   @relation(fields: [courseVersionId], references: [id])

  @@unique([programId, courseVersionId])
  @@unique([programId, displayOrder])
  @@index([companyId])
  @@map("program_courses")
}

model ProgramCohort {
  id          Int                 @id @default(autoincrement())
  companyId   Int
  programId   Int
  name        String              @db.VarChar(100)
  capacity    Int?
  startDate   DateTime?
  endDate     DateTime?
  company     Company             @relation(fields: [companyId], references: [id])
  program     LearningProgram     @relation(fields: [programId], references: [id])
  enrollments ProgramEnrollment[]

  @@unique([programId, name])
  @@index([companyId])
  @@map("program_cohorts")
}

model ProgramEnrollment {
  id                  Int                        @id @default(autoincrement())
  companyId           Int
  employeeId          String                     @db.VarChar(20)
  programId           Int
  cohortId            Int?
  enrollmentStatus    EnrollmentStatus
  progressPercentage  Decimal                    @default(0) @db.Decimal(5, 2)
  enrolledAt          DateTime                   @default(now())
  startDate           DateTime?
  dueDate             DateTime?
  completedAt         DateTime?
  assignedBy          Int?
  deletedAt           DateTime?
  company             Company                    @relation(fields: [companyId], references: [id])
  employee            Employee                   @relation(fields: [employeeId], references: [id])
  program             LearningProgram            @relation(fields: [programId], references: [id])
  cohort              ProgramCohort?             @relation(fields: [cohortId], references: [id])
  assignedByUser      AppUser?                   @relation(fields: [assignedBy], references: [id])
  completion          ProgramCompletion?
  milestoneProgresses ProgramMilestoneProgress[]
  enrollments         Enrollment[]

  @@unique([employeeId, programId])
  @@index([companyId])
  @@map("program_enrollments")
}

model ProgramMilestone {
  id                   Int                        @id @default(autoincrement())
  companyId            Int
  programId            Int
  title                String                     @db.VarChar(255)
  milestonePercentage  Decimal                    @db.Decimal(5, 2)
  targetDate           DateTime?
  targetOffsetDays     Int?
  completionExpression Json?
  overdueAction        String?                    @db.Text
  reminderOffsetsDays  Int[]
  company              Company                    @relation(fields: [companyId], references: [id])
  program              LearningProgram            @relation(fields: [programId], references: [id])
  progresses           ProgramMilestoneProgress[]

  @@unique([programId, milestonePercentage])
  @@index([companyId])
  @@map("program_milestones")
}

model ProgramMilestoneProgress {
  id                  Int               @id @default(autoincrement())
  companyId           Int
  milestoneId         Int
  programEnrollmentId Int
  status              MilestoneStatus   @default(NOT_STARTED)
  achievedAt          DateTime?
  overdueAt           DateTime?
  remarks             String?           @db.Text
  company             Company           @relation(fields: [companyId], references: [id])
  milestone           ProgramMilestone  @relation(fields: [milestoneId], references: [id])
  programEnrollment   ProgramEnrollment @relation(fields: [programEnrollmentId], references: [id])

  @@unique([milestoneId, programEnrollmentId])
  @@index([companyId])
  @@map("program_milestone_progresses")
}

model TaskType {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(100)
  slug        String  @db.VarChar(80)
  description String?
  icon        String?

  expectedSubmissionType TaskSubmissionType // reuses your existing enum
  linkedEntity           TaskLinkedEntity // ADDED — tells app code which single polymorphic FK on ProgramTask should be populated for tasks of this type

  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  tasks   ProgramTask[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("task_types")
}

model ProgramTask {
  id        Int @id @default(autoincrement())
  companyId Int
  programId Int

  title       String  @db.VarChar(255)
  description String? @db.Text

  taskTypeId Int

  courseVersionId Int?
  courseContentId Int?
  assessmentId    Int?
  liveSessionId   Int?
  surveyId        Int?

  maxSubmissions    Int?    @default(1)
  allowResubmission Boolean @default(false)

  isRequired   Boolean @default(true)
  isBlocking   Boolean @default(false)
  displayOrder Int
  phaseNumber  Int?

  // dueDate (absolute) takes precedence if set. dueOffsetDays (relative
  // to program enrollment date) is used only when dueDate is null.
  // A task should realistically use one or the other, not both.
  dueDate       DateTime?
  dueOffsetDays Int?

  minimumTimeMinutes Int?
  minimumScore       Decimal? @db.Decimal(5, 2)
  minimumAttendance  Decimal? @db.Decimal(5, 2)

  requiresManagerApproval Boolean @default(false)
  peerReviewRequired      Boolean @default(false)
  requiredPeerReviewCount Int?    @default(3) // ADDED — how many distinct peer reviews are needed when peerReviewRequired=true

  xpAward Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company         @relation(fields: [companyId], references: [id])
  program  LearningProgram @relation(fields: [programId], references: [id])
  taskType TaskType        @relation(fields: [taskTypeId], references: [id])

  courseVersion CourseVersion? @relation(fields: [courseVersionId], references: [id])
  courseContent CourseContent? @relation(fields: [courseContentId], references: [id])
  assessment    Assessment?    @relation(fields: [assessmentId], references: [id])
  liveSession   LiveSession?   @relation(fields: [liveSessionId], references: [id])
  survey        Survey?        @relation(fields: [surveyId], references: [id])

  submissions Submission[]

  @@unique([programId, displayOrder])
  @@index([companyId])
  @@index([taskTypeId])
  @@map("program_tasks")
}

model ProgramTag {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String   @db.VarChar(100)
  color     String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id])
  mappings ProgramTagMapping[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("program_tags")
}

model ProgramTagMapping {
  id        Int      @id @default(autoincrement())
  companyId Int
  programId Int
  tagId     Int
  createdAt DateTime @default(now())

  company Company         @relation(fields: [companyId], references: [id])
  program LearningProgram @relation(fields: [programId], references: [id])
  tag     ProgramTag      @relation(fields: [tagId], references: [id])

  @@unique([programId, tagId])
  @@index([companyId])
  @@map("program_tag_mappings")
}

///////////////////////////////////////////////////////////
// ENROLLMENT & LEARNING PROGRESS
///////////////////////////////////////////////////////////

model Enrollment {
  id                     Int                     @id @default(autoincrement())
  companyId              Int
  employeeId             String                  @db.VarChar(20)
  courseVersionId        Int
  programEnrollmentId    Int?
  /**
   * Allows multiple enrollments (retakes, renewals).
   * Default = 1 (first enrollment)
   */
  enrollmentNo           Int                     @default(1)
  enrollmentType         EnrollmentType
  enrollmentSource       EnrollmentSource
  status                 EnrollmentStatus
  approvalStatus         ApprovalStatus?
  enrolledAt             DateTime                @default(now())
  approvedAt             DateTime?
  startedAt              DateTime?
  dueDate                DateTime?
  completedAt            DateTime?
  cancelledAt            DateTime?
  expiredAt              DateTime?
  assignedBy             Int?
  approvedBy             Int?
  cancelledReason        String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  company                Company                 @relation(fields: [companyId], references: [id])
  employee               Employee                @relation(fields: [employeeId], references: [id])
  programEnrollment      ProgramEnrollment?      @relation(fields: [programEnrollmentId], references: [id])
  courseVersion          CourseVersion           @relation(fields: [courseVersionId], references: [id])
  assignmentUser         AppUser?                @relation("EnrollmentAssignedBy", fields: [assignedBy], references: [id])
  approvalUser           AppUser?                @relation("EnrollmentApprovedBy", fields: [approvedBy], references: [id])
  progress               LearningProgress?
  completion             CourseCompletion?
  assessmentAttempts     AssessmentAttempt[]
  waitlistEntry          WaitlistEntry?
  sessions               LearningSession[]
  activityLogs           EnrollmentActivityLog[]
  liveSessionAttendances LiveSessionAttendance[]
  liveSessionWaitlists   LiveSessionWaitlist[]
  submissions            Submission[]

  @@unique([employeeId, courseVersionId, enrollmentNo])
  @@index([companyId])
  @@index([employeeId])
  @@index([courseVersionId])
  @@map("enrollments")
}

model EnrollmentRuleType {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100) // e.g. "Auto Enroll"
  slug        String   @db.VarChar(80) // e.g. "auto_enroll"
  description String?
  isSystem    Boolean  @default(false) // Protect defaults
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id])
  rules   EnrollmentRule[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("enrollment_rule_types")
}

model EnrollmentRule {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(255)
  description String? @db.Text

  entityType      EnrollmentEntityType
  courseVersionId Int?
  programId       Int?

  ruleTypeId Int // ← Changed to FK

  priority Int     @default(1)
  isActive Boolean @default(true)

  targetAudienceId    Int?
  conditionExpression Json?

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company            @relation(fields: [companyId], references: [id])
  courseVersion  CourseVersion?     @relation("EnrollmentRuleCourseVersion", fields: [courseVersionId], references: [id])
  program        LearningProgram?   @relation("EnrollmentRuleProgram", fields: [programId], references: [id])
  ruleType       EnrollmentRuleType @relation(fields: [ruleTypeId], references: [id])
  targetAudience TargetAudience?    @relation(fields: [targetAudienceId], references: [id])
  creator        AppUser            @relation("EnrollmentRuleCreator", fields: [createdBy], references: [id])
  updater        AppUser?           @relation("EnrollmentRuleUpdater", fields: [updatedBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@index([courseVersionId])
  @@index([programId])
  @@index([ruleTypeId])
  @@index([targetAudienceId])
  @@map("enrollment_rules")
}

model LearningProgress {
  id           Int @id @default(autoincrement())
  companyId    Int
  enrollmentId Int @unique

  // Cache only — always derivable from LessonProgress / AssessmentAttempt.
  // Application layer must keep these in sync on every write; never
  // treat as source of truth for reporting reconciliation.
  overallProgress      Decimal          @db.Decimal(5, 2)
  completedLessons     Int
  totalLessons         Int
  completedAssessments Int
  totalAssessments     Int
  totalLearningMinutes Int
  lastAccessedAt       DateTime?
  lastContentId        Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  company              Company          @relation(fields: [companyId], references: [id])
  enrollment           Enrollment       @relation(fields: [enrollmentId], references: [id])
  lastContent          CourseContent?   @relation(fields: [lastContentId], references: [id])
  lessonProgress       LessonProgress[]

  @@index([companyId])
  @@map("learning_progress")
}

model LessonProgress {
  id                  Int              @id @default(autoincrement())
  companyId           Int
  learningProgressId  Int
  contentId           Int
  status              ProgressStatus // reusing shared enum, not a separate LessonStatus
  watchPercentage     Decimal?         @db.Decimal(5, 2)
  lastPositionSeconds Int?             @default(0) // enables exact resume, restored from earlier design
  attempts            Int              @default(0) // for quiz/assignment-type content specifically
  startedAt           DateTime?
  completedAt         DateTime?
  timeSpentMinutes    Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  company             Company          @relation(fields: [companyId], references: [id])
  learningProgress    LearningProgress @relation(fields: [learningProgressId], references: [id])
  content             CourseContent    @relation(fields: [contentId], references: [id])

  @@unique([learningProgressId, contentId])
  @@index([companyId])
  @@map("lesson_progress")
}

// Restored — analytics-only layer, NOT authoritative for progress
// (LessonProgress/LearningProgress remain source of truth). Needed for
// learning-hours totals, active-streak calculation, and inactive-learner
// detection, none of which are derivable from an aggregate minutes count alone.
model LearningSession {
  id           Int        @id @default(autoincrement())
  companyId    Int
  enrollmentId Int
  sessionStart DateTime
  sessionEnd   DateTime?
  totalSeconds Int        @default(0)
  deviceType   String?    @db.VarChar(30)
  ipAddress    String?    @db.VarChar(45)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  company      Company    @relation(fields: [companyId], references: [id])
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  @@index([companyId])
  @@index([enrollmentId])
  @@map("learning_sessions")
}

model EnrollmentActivityLog {
  id              Int               @id @default(autoincrement())
  companyId       Int
  enrollmentId    Int
  activityType    String            @db.VarChar(50) // consider an enum once event set stabilizes
  previousStatus  EnrollmentStatus?
  currentStatus   EnrollmentStatus?
  performedBy     Int? // AppUser — null = system-generated
  metadata        Json?
  createdAt       DateTime          @default(now())
  company         Company           @relation(fields: [companyId], references: [id])
  enrollment      Enrollment        @relation(fields: [enrollmentId], references: [id])
  performedByUser AppUser?          @relation(fields: [performedBy], references: [id])

  @@index([companyId])
  @@index([enrollmentId])
  @@index([activityType])
  @@map("enrollment_activity_logs")
}

model WaitlistEntry {
  id           Int            @id @default(autoincrement())
  companyId    Int
  enrollmentId Int            @unique
  position     Int
  status       WaitlistStatus
  offeredAt    DateTime?
  acceptedAt   DateTime?
  expiredAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  company      Company        @relation(fields: [companyId], references: [id])
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id])

  @@index([companyId])
  @@index([status])
  @@map("waitlist_entries")
}

model CourseCompletion {
  id                 Int           @id @default(autoincrement())
  companyId          Int
  enrollmentId       Int           @unique
  finalScore         Decimal       @db.Decimal(5, 2)
  passed             Boolean
  completedAt        DateTime
  completionSnapshot Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id])
  enrollment         Enrollment    @relation(fields: [enrollmentId], references: [id])
  review             CourseReview?

  // Certificate now references CourseCompletion ONLY (not Enrollment
  // directly) — removed the duplicate 1:1 from Enrollment to avoid two
  // independent FKs that could point to inconsistent records.
  certificate      Certificate?
  effectiveness    TrainingEffectiveness?
  skillAssessments EmployeeSkillAssessment[]
  surveyResponses  SurveyResponse[]

  @@index([companyId])
  @@map("course_completions")
}

model ProgramCompletion {
  id                  Int               @id @default(autoincrement())
  companyId           Int
  programEnrollmentId Int               @unique
  completedAt         DateTime
  completionSnapshot  Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  company             Company           @relation(fields: [companyId], references: [id])
  programEnrollment   ProgramEnrollment @relation(fields: [programEnrollmentId], references: [id])
  certificate         Certificate?

  @@index([companyId])
  @@map("program_completions")
}

///////////////////////////////////////////////////////////
// ASSESSMENT & QUESTION BANK
///////////////////////////////////////////////////////////

model GradingMethod {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  assessments         Assessment[]
  assessmentTemplates AssessmentTemplate[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("grading_methods")
}

model AssessmentType {
  id        Int  @id @default(autoincrement())
  companyId Int?

  code        String  @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.Text

  isScored   Boolean @default(true)
  isPractice Boolean @default(false)
  isGraded   Boolean @default(true)

  isSystem Boolean @default(false) // FIXED — was @default(true), inconsistent with every other lookup table (GradingMethod, QuestionType, DifficultyLevel all default false). A company-created row must not be born "protected" by default.
  isActive Boolean @default(true)

  displayOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  assessments Assessment[]
  templates   AssessmentTemplate[]

  @@unique([companyId, code])
  @@map("assessment_types")
}

model Assessment {
  id              Int  @id @default(autoincrement())
  companyId       Int
  courseVersionId Int
  contentId       Int?
  templateId      Int?

  title       String  @db.VarChar(255)
  description String? @db.Text

  assessmentTypeId Int
  gradingMethodId  Int

  passingScore Decimal @db.Decimal(5, 2) // Percentage required (e.g. 70.00)

  // CACHE ONLY — always derivable via SUM(assessment_questions.weight)
  // for this assessmentId. Recalculate and update this field every
  // time an AssessmentQuestion is added, removed, or reweighted.
  // Never treat as source of truth for grading/reporting; if it can
  // drift, recompute from assessment_questions directly.
  totalMarks Decimal @default(0) @db.Decimal(8, 2)

  maxAttempts     Int
  durationMinutes Int?

  negativeMarking Decimal? @db.Decimal(5, 2)

  showCorrectAnswersAfterAllSubmit Boolean @default(false)
  allowQuestionReview              Boolean @default(true)
  autoSubmitOnTimeLimit            Boolean @default(false)
  tabSwitchLimit                   Int?

  lockdownBrowser       Boolean @default(false)
  proctoringEnabled     Boolean @default(false)
  randomizeQuestions    Boolean @default(false)
  randomizeOptions      Boolean @default(false)
  showResultImmediately Boolean @default(false)

  status ContentLifecycleStatus

  pairedAssessmentId Int?

  createdBy Int
  updatedBy Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company       Company             @relation(fields: [companyId], references: [id])
  courseVersion CourseVersion       @relation(fields: [courseVersionId], references: [id])
  content       CourseContent?      @relation(fields: [contentId], references: [id])
  template      AssessmentTemplate? @relation(fields: [templateId], references: [id])

  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  gradingMethod  GradingMethod  @relation(fields: [gradingMethodId], references: [id])

  pairedAssessment Assessment?  @relation("AssessmentPair", fields: [pairedAssessmentId], references: [id])
  pairedWith       Assessment[] @relation("AssessmentPair")

  createdByUser AppUser  @relation("AssessmentCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser? @relation("AssessmentUpdatedBy", fields: [updatedBy], references: [id])

  questions              AssessmentQuestion[]
  blueprints             AssessmentBlueprint[]
  attempts               AssessmentAttempt[]
  programTasks           ProgramTask[]
  assessmentAttemptRules AssessmentAttemptRule[]

  @@index([companyId])
  @@index([courseVersionId])
  @@index([assessmentTypeId])
  @@index([gradingMethodId])
  @@map("assessments")
}

model QuestionBank {
  id        Int @id @default(autoincrement())
  companyId Int

  name        String  @db.VarChar(255)
  code        String? @db.VarChar(100)
  description String? @db.Text

  categoryId Int?
  topicId    Int?

  isActive Boolean @default(true)

  createdBy Int
  updatedBy Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company         @relation(fields: [companyId], references: [id])
  category CourseCategory? @relation(fields: [categoryId], references: [id])
  topic    Topic?          @relation(fields: [topicId], references: [id])

  creator AppUser  @relation("QuestionBankCreator", fields: [createdBy], references: [id])
  updater AppUser? @relation("QuestionBankUpdater", fields: [updatedBy], references: [id])

  questions Question[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([categoryId])
  @@index([topicId])
  @@map("question_banks")
}

model QuestionType {
  id              Int                     @id @default(autoincrement())
  companyId       Int
  name            String                  @db.VarChar(100)
  slug            String                  @db.VarChar(80)
  description     String?
  answerStructure QuestionAnswerStructure

  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id])
  questions  Question[]
  blueprints AssessmentBlueprint[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("question_types")
}

model AssessmentBlueprint {
  id           Int @id @default(autoincrement())
  companyId    Int
  assessmentId Int

  topicId           Int?
  questionTypeId    Int?
  questionCount     Int
  difficultyLevelId Int?

  difficultyLevel DifficultyLevel? @relation(fields: [difficultyLevelId], references: [id])
  company         Company          @relation(fields: [companyId], references: [id])
  assessment      Assessment       @relation(fields: [assessmentId], references: [id])
  topic           Topic?           @relation(fields: [topicId], references: [id])
  questionType    QuestionType?    @relation(fields: [questionTypeId], references: [id])

  @@index([companyId])
  @@index([assessmentId])
  @@index([questionTypeId])
  @@index([difficultyLevelId]) // FIXED — moved before @@map, was after it (invalid placement)
  @@map("assessment_blueprints")
}

model AssessmentQuestion {
  id Int @id @default(autoincrement())

  companyId    Int
  assessmentId Int

  questionId        Int
  questionVersionId Int

  weight Decimal @default(1) @db.Decimal(8, 2)

  displayOrder Int
  isRequired   Boolean @default(true)

  company    Company    @relation(fields: [companyId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  question        Question        @relation(fields: [questionId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  @@unique([assessmentId, questionVersionId])
  @@index([assessmentId])
  @@index([questionId])
  @@map("assessment_questions")
}

model Topic {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(150)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  questions     Question[]
  blueprints    AssessmentBlueprint[]
  questionBanks QuestionBank[]

  @@unique([companyId, name])
  @@map("topics")
}

model Question {
  id                Int            @id @default(autoincrement())
  companyId         Int
  currentVersionId  Int?           @unique
  topicId           Int?
  difficultyLevelId Int
  questionTypeId    Int
  questionBankId    Int
  status            QuestionStatus
  createdBy         Int
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  difficultyLevel DifficultyLevel      @relation(fields: [difficultyLevelId], references: [id])
  company         Company              @relation(fields: [companyId], references: [id])
  questionType    QuestionType         @relation(fields: [questionTypeId], references: [id])
  currentVersion  QuestionVersion?     @relation("CurrentQuestionVersion", fields: [currentVersionId], references: [id])
  createdByUser   AppUser              @relation(fields: [createdBy], references: [id])
  questionBank    QuestionBank         @relation(fields: [questionBankId], references: [id])
  versions        QuestionVersion[]    @relation("QuestionVersions")
  mappings        AssessmentQuestion[]
  topic           Topic?               @relation(fields: [topicId], references: [id])

  @@index([companyId])
  @@index([difficultyLevelId])
  @@index([questionBankId]) // FIXED — moved before @@map, was after it (invalid placement)
  @@map("questions")
}

model QuestionVersion {
  id           Int      @id @default(autoincrement())
  companyId    Int
  questionId   Int
  versionNo    Int
  questionText String   @db.Text
  explanation  String?  @db.Text
  defaultScore Decimal  @db.Decimal(8, 2)
  createdBy    Int
  createdAt    DateTime @default(now())

  company             Company                @relation(fields: [companyId], references: [id])
  question            Question               @relation("QuestionVersions", fields: [questionId], references: [id])
  currentQuestion     Question?              @relation("CurrentQuestionVersion")
  createdByUser       AppUser                @relation(fields: [createdBy], references: [id])
  options             QuestionOption[]
  matchingPairs       QuestionMatchingPair[]
  assessmentQuestions AssessmentQuestion[]
  answers             AssessmentAnswer[]

  @@unique([questionId, versionNo])
  @@map("question_versions")
}

// Handles: Multiple Choice, True/False, Fill-in-the-Blank (single or
// multi-blank via blankIndex), Ordering/Sequencing (displayOrder =
// correct sequence). Drag-and-drop-to-order is a frontend interaction
// on this same data, not a separate structure.
model QuestionOption {
  id                Int @id @default(autoincrement())
  companyId         Int
  questionVersionId Int

  blankIndex Int? // groups accepted answers by blank position for multi-blank FILL_BLANK; null otherwise

  optionLabel   String?
  optionText    String   @db.Text
  isCorrect     Boolean
  caseSensitive Boolean? // meaningful only for FILL_BLANK
  displayOrder  Int

  createdAt DateTime @default(now())

  company         Company         @relation(fields: [companyId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  answerSelections AssessmentAnswerOption[]

  @@unique([questionVersionId, displayOrder])
  @@index([questionVersionId, blankIndex])
  @@map("question_options")
}

// Handles: Matching, and Categorization/Drag-Drop-to-bucket (multiple
// leftValue rows sharing one rightValue).
model QuestionMatchingPair {
  id                Int @id @default(autoincrement())
  companyId         Int
  questionVersionId Int

  leftValue    String @db.Text
  rightValue   String @db.Text
  displayOrder Int

  createdAt DateTime @default(now())

  company         Company         @relation(fields: [companyId], references: [id])
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id])

  leftPairSubmissions  AssessmentAnswerMatch[] @relation("LeftPairSubmissions")
  rightPairSubmissions AssessmentAnswerMatch[] @relation("RightPairSubmissions")

  @@index([companyId])
  @@index([questionVersionId])
  @@map("question_matching_pairs")
}

model AssessmentAttempt {
  id Int @id @default(autoincrement())

  companyId    Int
  enrollmentId Int
  assessmentId Int

  attemptNo Int
  status    AttemptStatus

  startedAt   DateTime
  submittedAt DateTime?
  gradedAt    DateTime?

  gradedBy Int?

  score      Decimal? @db.Decimal(8, 2)
  percentage Decimal? @db.Decimal(5, 2)

  passed   Boolean?
  snapshot Json?

  deletedAt DateTime?

  company      Company    @relation(fields: [companyId], references: [id])
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  gradedByUser AppUser?   @relation("GradedBy", fields: [gradedBy], references: [id])

  answers AssessmentAnswer[]

  @@unique([assessmentId, enrollmentId, attemptNo])
  @@index([companyId])
  @@map("assessment_attempts")
}

model AssessmentAttemptRule {
  id           Int @id @default(autoincrement())
  companyId    Int
  assessmentId Int
  attemptNo    Int

  scoreMultiplier Decimal? @db.Decimal(5, 2) // e.g. 1.00, 0.80, 0.60
  maxScore        Decimal? @db.Decimal(8, 2)

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  company    Company    @relation(fields: [companyId], references: [id])

  @@unique([assessmentId, attemptNo])
  @@index([companyId])
  @@map("assessment_attempt_rules")
}

// Submissions stored in junction tables (AssessmentAnswerOption, AssessmentAnswerMatch) – not as JSON.
// Benefits: FK integrity, SQL-queryable grading/reporting.
// Follows schema's preference for structured relations over JSON.
model AssessmentAnswer {
  id                Int @id @default(autoincrement())
  companyId         Int
  attemptId         Int
  questionVersionId Int

  // FREE_TEXT only (Essay/Short Answer) — the only structure genuinely
  // suited to a single text field rather than normalized rows.
  answerText String? @db.Text

  awardedMarks   Decimal?           @db.Decimal(8, 2)
  isCorrect      Boolean?
  approvalStatus AnswerReviewStatus

  approvedBy Int?
  approvedAt DateTime?

  company         Company           @relation(fields: [companyId], references: [id])
  attempt         AssessmentAttempt @relation(fields: [attemptId], references: [id])
  questionVersion QuestionVersion   @relation(fields: [questionVersionId], references: [id])
  approvedByUser  AppUser?          @relation(fields: [approvedBy], references: [id])

  selectedOptions  AssessmentAnswerOption[]
  submittedMatches AssessmentAnswerMatch[]

  @@unique([attemptId, questionVersionId])
  @@index([attemptId])
  @@index([questionVersionId])
  @@map("assessment_answers")
}

// For OPTION_BASED questions: selected QuestionOption(s).
// For FILL_BLANK: typedText stores the actual typed answer (compared to QuestionOption.optionText at grading, using caseSensitive). No direct FK to QuestionOption, since answers aren't pre-listed.
model AssessmentAnswerOption {
  id               Int     @id @default(autoincrement())
  companyId        Int
  answerId         Int
  questionOptionId Int?
  blankIndex       Int?
  typedText        String? @db.Text

  createdAt DateTime @default(now())

  company        Company          @relation(fields: [companyId], references: [id])
  answer         AssessmentAnswer @relation(fields: [answerId], references: [id])
  questionOption QuestionOption?  @relation(fields: [questionOptionId], references: [id])

  @@index([companyId])
  @@index([answerId])
  @@index([questionOptionId])
  @@map("assessment_answer_options")
}

// leftPairId and rightPairId both reference QuestionMatchingPair.
// Correct match: leftPairId == rightPairId (same row).
// Mismatch: any other combination submitted.
model AssessmentAnswerMatch {
  id          Int @id @default(autoincrement())
  companyId   Int
  answerId    Int
  leftPairId  Int
  rightPairId Int

  createdAt DateTime @default(now())

  company   Company              @relation(fields: [companyId], references: [id])
  answer    AssessmentAnswer     @relation(fields: [answerId], references: [id])
  leftPair  QuestionMatchingPair @relation("LeftPairSubmissions", fields: [leftPairId], references: [id])
  rightPair QuestionMatchingPair @relation("RightPairSubmissions", fields: [rightPairId], references: [id])

  @@index([companyId])
  @@index([answerId])
  @@map("assessment_answer_matches")
}

///////////////////////////////////////////////////////////
// CERTIFICATION
///////////////////////////////////////////////////////////

model CertificateType {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company               @relation(fields: [companyId], references: [id])
  templates CertificateTemplate[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("certificate_types")
}

model Certificate {
  id        Int @id @default(autoincrement())
  companyId Int

  issuanceType        CertificateIssuanceType
  completionId        Int?                    @unique
  programCompletionId Int?                    @unique

  // MANUAL issuance only — who requested/justified it and why, since
  // there's no completion record to derive that context from.
  manualIssueReason         String? @db.Text
  manualIssuedByUserId      Int?
  manualRecipientEmployeeId String? @db.VarChar(20) // required when issuanceType=MANUAL, since there's no completion->enrollment->employee chain to derive the recipient from

  templateId Int

  certificateNumber String            @db.VarChar(100)
  issuedAt          DateTime
  expiresAt         DateTime?
  verificationCode  String            @unique @db.VarChar(100)
  verificationQrUrl String?
  status            CertificateStatus
  revokedAt         DateTime?
  revokedReason     String?           @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company                 Company                   @relation(fields: [companyId], references: [id])
  completion              CourseCompletion?         @relation(fields: [completionId], references: [id])
  programCompletion       ProgramCompletion?        @relation(fields: [programCompletionId], references: [id])
  template                CertificateTemplate       @relation(fields: [templateId], references: [id])
  manualIssuedByUser      AppUser?                  @relation("CertificateManualIssuedBy", fields: [manualIssuedByUserId], references: [id])
  manualRecipientEmployee Employee?                 @relation("CertificateManualRecipient", fields: [manualRecipientEmployeeId], references: [id])
  verificationLogs        CertificateVerification[]

  @@unique([companyId, certificateNumber])
  @@index([companyId])
  @@index([issuanceType])
  @@map("certificates")
}

model CertificateVerification {
  id                   Int                @id @default(autoincrement())
  companyId            Int
  certificateId        Int
  verificationMethod   VerificationMethod
  verifiedAt           DateTime           @default(now())
  ipAddress            String?            @db.VarChar(50)
  userAgent            String?
  verifiedByEmployeeId String?            @db.VarChar(20)

  company     Company     @relation(fields: [companyId], references: [id])
  certificate Certificate @relation(fields: [certificateId], references: [id])
  verifiedBy  Employee?   @relation(fields: [verifiedByEmployeeId], references: [id])

  @@index([companyId])
  @@index([certificateId])
  @@map("certificate_verifications")
}

model CredentialSource {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company               @relation(fields: [companyId], references: [id])
  certificates ExternalCertificate[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("credential_sources")
}

model ExternalCertificate {
  id                 Int                      @id @default(autoincrement())
  companyId          Int
  employeeId         String                   @db.VarChar(20)
  providerId         Int
  certificateName    String                   @db.VarChar(255)
  credentialNumber   String?
  issueDate          DateTime
  expiryDate         DateTime?
  verificationStatus ExternalCredentialStatus

  sourceId Int

  uploadedFile String?
  apiReference String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company          @relation(fields: [companyId], references: [id])
  employee Employee         @relation(fields: [employeeId], references: [id])
  provider ExternalProvider @relation(fields: [providerId], references: [id])
  source   CredentialSource @relation(fields: [sourceId], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([sourceId])
  @@map("external_certificates")
}

model ProviderType {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company            @relation(fields: [companyId], references: [id])
  providers ExternalProvider[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("provider_types")
}

model ExternalProvider {
  id             Int    @id @default(autoincrement())
  companyId      Int
  name           String @db.VarChar(150)
  providerTypeId Int

  apiEndpoint     String?
  apiKeyReference String?
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company               @relation(fields: [companyId], references: [id])
  providerType ProviderType          @relation(fields: [providerTypeId], references: [id])
  certificates ExternalCertificate[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([providerTypeId])
  @@map("external_providers")
}

///////////////////////////////////////////////////////////
// LIVE SESSIONS (ILT / VIRTUAL TRAINING)
///////////////////////////////////////////////////////////

model MeetingProvider {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100) // e.g. "Zoom"
  slug        String   @db.VarChar(80) // e.g. "zoom"
  description String?
  isSystem    Boolean  @default(false) // Protect defaults
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  liveSessions LiveSession[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("meeting_providers")
}

model LiveSession {
  id                Int               @id @default(autoincrement())
  companyId         Int
  courseVersionId   Int
  learningProgramId Int?
  title             String            @db.VarChar(255)
  description       String?           @db.Text
  sessionType       SessionType
  status            LiveSessionStatus
  startTime         DateTime
  endTime           DateTime
  timezone          String            @db.VarChar(100)
  venue             String?           @db.VarChar(255)
  meetingUrl        String?
  meetingProviderId Int? // ← Changed to FK

  capacity           Int
  waitlistCapacity   Int?
  recordingUrl       String?
  attendanceRequired Boolean @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  courseVersion   CourseVersion    @relation("CourseVersionLiveSessions", fields: [courseVersionId], references: [id])
  learningProgram LearningProgram? @relation(fields: [learningProgramId], references: [id])
  meetingProvider MeetingProvider? @relation(fields: [meetingProviderId], references: [id])

  createdByUser AppUser  @relation("LiveSessionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser? @relation("LiveSessionUpdatedBy", fields: [updatedBy], references: [id])

  instructors          LiveSessionInstructor[]
  attendees            LiveSessionAttendance[]
  liveSessionWaitlists LiveSessionWaitlist[]
  programTasks         ProgramTask[]

  @@index([companyId])
  @@index([courseVersionId])
  @@index([meetingProviderId])
  @@index([startTime])
  @@map("live_sessions")
}

model LiveSessionInstructor {
  id        Int @id @default(autoincrement())
  companyId Int
  sessionId Int

  employeeId String?  @db.VarChar(20)
  appUserId  Int? // For external instructors / platform admins
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  company  Company     @relation(fields: [companyId], references: [id])
  session  LiveSession @relation(fields: [sessionId], references: [id])
  employee Employee?   @relation(fields: [employeeId], references: [id])
  appUser  AppUser?    @relation(fields: [appUserId], references: [id])

  @@index([companyId])
  @@index([sessionId])
  @@index([employeeId])
  @@index([appUserId])
  @@map("live_session_instructors")
}

model AttendanceMethod {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100) // e.g. "QR Code", "Face Recognition"
  slug        String   @db.VarChar(80) // e.g. "qr_code"
  description String?
  icon        String?
  isSystem    Boolean  @default(false) // Protect default methods
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id])
  attendances LiveSessionAttendance[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("attendance_methods")
}

model LiveSessionAttendance {
  id           Int @id @default(autoincrement())
  companyId    Int
  sessionId    Int
  enrollmentId Int

  attendanceStatus   AttendanceStatus
  attendanceMethodId Int? // ← Changed to FK

  checkInTime          DateTime?
  checkOutTime         DateTime?
  attendancePercentage Decimal?  @db.Decimal(5, 2)

  remarks String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company          Company           @relation(fields: [companyId], references: [id])
  session          LiveSession       @relation(fields: [sessionId], references: [id])
  enrollment       Enrollment        @relation(fields: [enrollmentId], references: [id])
  attendanceMethod AttendanceMethod? @relation(fields: [attendanceMethodId], references: [id])

  @@unique([sessionId, enrollmentId])
  @@index([companyId])
  @@index([attendanceStatus])
  @@index([attendanceMethodId])
  @@map("live_session_attendance")
}

model LiveSessionWaitlist {
  id            Int            @id @default(autoincrement())
  companyId     Int
  sessionId     Int
  enrollmentId  Int
  queuePosition Int
  status        WaitlistStatus
  offeredAt     DateTime?
  acceptedAt    DateTime?
  expiredAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id])
  session       LiveSession    @relation(fields: [sessionId], references: [id])
  enrollment    Enrollment     @relation(fields: [enrollmentId], references: [id])

  @@unique([sessionId, enrollmentId])
  @@unique([sessionId, queuePosition])
  @@index([companyId])
  @@map("live_session_waitlists")
}

///////////////////////////////////////////////////////////
// SURVEYS & TRAINING EFFECTIVENESS
///////////////////////////////////////////////////////////

model Survey {
  id               Int              @id @default(autoincrement())
  companyId        Int
  courseVersionId  Int?
  title            String           @db.VarChar(255)
  description      String?          @db.Text
  surveyType       SurveyType
  kirkpatrickLevel KirkpatrickLevel
  isAnonymous      Boolean          @default(false) // UI/report-level anonymity only — see SurveyResponse note
  status           SurveyStatus
  availableFrom    DateTime?
  availableUntil   DateTime?
  createdBy        Int
  updatedBy        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  company          Company          @relation(fields: [companyId], references: [id])
  courseVersion    CourseVersion?   @relation(fields: [courseVersionId], references: [id])
  createdByUser    AppUser          @relation("SurveyCreatedBy", fields: [createdBy], references: [id])
  updatedByUser    AppUser?         @relation("SurveyUpdatedBy", fields: [updatedBy], references: [id])
  questions        SurveyQuestion[]
  responses        SurveyResponse[]
  programTasks     ProgramTask[]

  @@index([companyId])
  @@map("surveys")
}

model SurveyQuestionType {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100) // e.g. "Rating Scale"
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  surveyQuestions SurveyQuestion[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("survey_question_types")
}

model SurveyQuestion {
  id             Int      @id @default(autoincrement())
  companyId      Int
  surveyId       Int
  questionText   String   @db.Text
  questionTypeId Int // ← Changed to FK
  displayOrder   Int
  isRequired     Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company      Company            @relation(fields: [companyId], references: [id])
  survey       Survey             @relation(fields: [surveyId], references: [id])
  questionType SurveyQuestionType @relation(fields: [questionTypeId], references: [id])
  responses    SurveyAnswer[]

  @@unique([surveyId, displayOrder])
  @@index([companyId])
  @@map("survey_questions")
}

model SurveyResponse {
  id           Int @id @default(autoincrement())
  companyId    Int
  surveyId     Int
  completionId Int

  // isAnonymous = true hides identity in UI/reports only. completionId
  // still traces to employee via completion -> enrollment -> employee.
  // Decision: UI-level anonymity, DB-level traceable for admin audit.
  employeeId  String?          @db.VarChar(20)
  submittedAt DateTime         @default(now())
  createdAt   DateTime         @default(now())
  company     Company          @relation(fields: [companyId], references: [id])
  survey      Survey           @relation(fields: [surveyId], references: [id])
  completion  CourseCompletion @relation(fields: [completionId], references: [id])
  employee    Employee?        @relation(fields: [employeeId], references: [id])
  answers     SurveyAnswer[]

  @@unique([surveyId, completionId])
  @@index([companyId])
  @@map("survey_responses")
}

model SurveyAnswer {
  id             Int            @id @default(autoincrement())
  companyId      Int
  responseId     Int
  questionId     Int
  ratingValue    Int?
  selectedOption String?
  textAnswer     String?        @db.Text
  createdAt      DateTime       @default(now())
  company        Company        @relation(fields: [companyId], references: [id])
  response       SurveyResponse @relation(fields: [responseId], references: [id])
  question       SurveyQuestion @relation(fields: [questionId], references: [id])

  @@unique([responseId, questionId])
  @@index([companyId])
  @@map("survey_answers")
}

model EffectivenessWeightConfig {
  id             Int      @id @default(autoincrement())
  companyId      Int
  reactionWeight Decimal  @db.Decimal(5, 2)
  learningWeight Decimal  @db.Decimal(5, 2)
  behaviorWeight Decimal  @db.Decimal(5, 2)
  resultsWeight  Decimal  @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  effectiveFrom  DateTime @default(now())
  createdBy      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company  @relation(fields: [companyId], references: [id])
  createdByUser  AppUser? @relation(fields: [createdBy], references: [id])

  // App-layer rule: the four weights on the active config row must
  // sum to 100 — validate on write, not enforceable via DB constraint.
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("effectiveness_weight_configs")
}

model TrainingEffectiveness {
  id                  Int       @id @default(autoincrement())
  companyId           Int
  completionId        Int       @unique
  reactionScore       Decimal?  @db.Decimal(5, 2)
  reactionEvaluatedAt DateTime?
  learningScore       Decimal?  @db.Decimal(5, 2)
  learningEvaluatedAt DateTime?
  behaviorScore       Decimal?  @db.Decimal(5, 2)
  behaviorEvaluatedAt DateTime?
  behaviorDueAt       DateTime?
  resultsScore        Decimal?  @db.Decimal(5, 2)
  resultsEvaluatedAt  DateTime?
  resultsDueAt        DateTime?

  // Weighted average using the company's active EffectivenessWeightConfig.
  // NULL component scores are excluded and remaining weights re-normalized
  // to 100 before applying. Recalculate on every component score change.
  overallScore Decimal?         @db.Decimal(5, 2)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  company      Company          @relation(fields: [companyId], references: [id])
  completion   CourseCompletion @relation(fields: [completionId], references: [id])

  @@index([companyId])
  @@map("training_effectiveness")
}

///////////////////////////////////////////////////////////
// TRAINING NEEDS ANALYSIS (TNA)
///////////////////////////////////////////////////////////
// Defines the categories of TNA requests.
model TnaRequestTypeConfig {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  requests TrainingNeedRequest[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("tna_request_type_configs")
}

// Defines how the training will be paid for.
model FundingType {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  requests TrainingNeedRequest[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("funding_types")
}

// Defines the preferred delivery format of the training
model TrainingFormat {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company               @relation(fields: [companyId], references: [id])
  requests TrainingNeedRequest[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("training_formats")
}

model TrainingNeedRequest {
  id         Int    @id @default(autoincrement())
  companyId  Int
  employeeId String @db.VarChar(20)

  requestTypeId Int
  fundingTypeId Int
  status        TnaStatus
  priority      PriorityLevel

  targetAudienceId Int?
  departmentId     Int?
  jobTitleId       Int?
  jobLevelId       Int?
  employmentTypeId Int?

  trainingTitle         String  @db.VarChar(255)
  providerName          String? @db.VarChar(255)
  objective             String? @db.Text
  competencyGap         String  @db.Text
  businessJustification String  @db.Text
  expectedOutcome       String? @db.Text

  preferredFormatId    Int?
  preferredStartDate   DateTime?
  targetCompletionDate DateTime?
  estimatedCost        Decimal?  @db.Decimal(12, 2)
  attachmentUrl        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company         Company              @relation(fields: [companyId], references: [id])
  employee        Employee             @relation(fields: [employeeId], references: [id])
  requestType     TnaRequestTypeConfig @relation(fields: [requestTypeId], references: [id])
  fundingType     FundingType          @relation(fields: [fundingTypeId], references: [id])
  preferredFormat TrainingFormat?      @relation(fields: [preferredFormatId], references: [id])
  targetAudience  TargetAudience?      @relation(fields: [targetAudienceId], references: [id])
  department      Department?          @relation(fields: [departmentId], references: [id])
  jobTitle        JobTitle?            @relation(fields: [jobTitleId], references: [id])
  employmentType  EmploymentType?      @relation(fields: [employmentTypeId], references: [id])

  skills          TrainingNeedSkill[]
  recommendations TnaRecommendation[]

  // NEW: Uses the shared Approval engine
  approvalInstances ApprovalWorkflowInstance[]
  tnaEmployees      TnaEmployee[]

  @@index([companyId])
  @@index([employeeId])
  @@index([status])
  @@index([fundingTypeId])
  @@index([preferredFormatId])
  @@index([targetAudienceId])
  @@map("training_need_requests")
}

model TnaEmployee {
  id                    Int    @id @default(autoincrement())
  companyId             Int
  trainingNeedRequestId Int
  employeeId            String @db.VarChar(20)

  createdAt DateTime @default(now())

  // Relation
  company  Company             @relation(fields: [companyId], references: [id])
  request  TrainingNeedRequest @relation(fields: [trainingNeedRequestId], references: [id], onDelete: Cascade)
  employee Employee            @relation(fields: [employeeId], references: [id])

  /// Prevent duplicate employee selection
  @@unique([trainingNeedRequestId, employeeId])
  @@index([companyId])
  @@index([trainingNeedRequestId])
  @@index([employeeId])
  @@map("training_need_request_employees")
}

model TrainingNeedSkill {
  id        Int      @id @default(autoincrement())
  companyId Int
  requestId Int
  skillId   Int
  createdAt DateTime @default(now())

  company Company             @relation(fields: [companyId], references: [id])
  request TrainingNeedRequest @relation(fields: [requestId], references: [id])
  skill   Skill               @relation(fields: [skillId], references: [id])

  @@unique([requestId, skillId])
  @@index([companyId])
  @@map("training_need_skills")
}

model TnaRecommendation {
  id                   Int                  @id @default(autoincrement())
  companyId            Int
  requestId            Int?
  courseVersionId      Int?
  learningProgramId    Int?
  recommendationSource RecommendationSource
  confidenceScore      Decimal?             @db.Decimal(5, 2)
  recommendationReason String?
  targetAudienceId     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company              @relation(fields: [companyId], references: [id])
  request         TrainingNeedRequest? @relation(fields: [requestId], references: [id])
  courseVersion   CourseVersion?       @relation(fields: [courseVersionId], references: [id])
  learningProgram LearningProgram?     @relation(fields: [learningProgramId], references: [id])
  targetAudience  TargetAudience?      @relation(fields: [targetAudienceId], references: [id])

  skills TnaRecommendationSkill[]

  @@index([companyId])
  @@index([requestId])
  @@index([targetAudienceId])
  @@map("tna_recommendations")
}

model TnaRecommendationSkill {
  id               Int      @id @default(autoincrement())
  companyId        Int
  recommendationId Int
  skillId          Int
  createdAt        DateTime @default(now())

  company        Company           @relation(fields: [companyId], references: [id])
  recommendation TnaRecommendation @relation(fields: [recommendationId], references: [id])
  skill          Skill             @relation(fields: [skillId], references: [id])

  @@unique([recommendationId, skillId])
  @@index([companyId])
  @@map("tna_recommendation_skills")
}

///////////////////////////////////////////////////////////
// GAMIFICATION & XP
///////////////////////////////////////////////////////////

model XpRuleCategory {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company  @relation(fields: [companyId], references: [id])
  xpRules XpRule[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("xp_rule_categories")
}

model XpTriggerEvent {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id])
  xpRules    XpRule[]
  badgeRules BadgeRule[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("xp_trigger_events")
}

model XpRule {
  id             Int      @id @default(autoincrement())
  companyId      Int
  name           String   @db.VarChar(150)
  categoryId     Int
  triggerEventId Int
  xpAmount       Int
  maximumAward   Int?
  multiplier     Decimal? @db.Decimal(5, 2)

  targetAudienceId    Int?
  conditionExpression Json?

  courseVersionId Int?
  programId       Int?
  isActive        Boolean @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  category       XpRuleCategory   @relation(fields: [categoryId], references: [id])
  triggerEvent   XpTriggerEvent   @relation(fields: [triggerEventId], references: [id])
  targetAudience TargetAudience?  @relation(fields: [targetAudienceId], references: [id])
  courseVersion  CourseVersion?   @relation(fields: [courseVersionId], references: [id])
  program        LearningProgram? @relation(fields: [programId], references: [id])
  createdByUser  AppUser          @relation("XpRuleCreatedBy", fields: [createdBy], references: [id])
  updatedByUser  AppUser?         @relation("XpRuleUpdatedBy", fields: [updatedBy], references: [id])
  transactions   XpTransaction[]

  @@index([companyId])
  @@index([categoryId])
  @@index([triggerEventId])
  @@index([targetAudienceId])
  @@index([courseVersionId])
  @@index([programId])
  @@map("xp_rules")
}

model XpTransaction {
  id         Int          @id @default(autoincrement())
  companyId  Int
  employeeId String       @db.VarChar(20)
  ruleId     Int?
  sourceType XpSourceType
  sourceId   Int?

  // Final pre-multiplied value — use SUM(xpAwarded) for totals.
  // multiplier is stored for audit only.
  xpAwarded  Int
  multiplier Decimal? @db.Decimal(5, 2)
  remarks    String?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])
  rule     XpRule?  @relation(fields: [ruleId], references: [id])

  @@unique([employeeId, ruleId, sourceId])
  @@index([companyId])
  @@index([employeeId])
  @@index([createdAt])
  @@map("xp_transactions")
}

model LearningLevel {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String   @db.VarChar(100)
  minimumXp    Int
  maximumXp    Int?
  badgeColor   String?
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, displayOrder])
  @@unique([companyId, minimumXp])
  @@map("learning_levels")
}

model BadgeCategory {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(80)
  description String?
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  badges  Badge[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("badge_categories")
}

model Badge {
  id              Int      @id @default(autoincrement())
  companyId       Int
  name            String   @db.VarChar(150)
  description     String?
  iconUrl         String?
  badgeCategoryId Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id])
  badgeCategory BadgeCategory   @relation(fields: [badgeCategoryId], references: [id])
  rules         BadgeRule[]
  awards        EmployeeBadge[]

  @@unique([companyId, name])
  @@index([badgeCategoryId])
  @@map("badges")
}

model BadgeRule {
  id                  Int      @id @default(autoincrement())
  companyId           Int
  badgeId             Int
  triggerEventId      Int?
  minimumXp           Int?
  minimumCourses      Int?
  minimumCertificates Int?
  minimumPrograms     Int?
  targetAudienceId    Int?
  customExpression    Json?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  badge          Badge           @relation(fields: [badgeId], references: [id])
  triggerEvent   XpTriggerEvent? @relation(fields: [triggerEventId], references: [id])
  targetAudience TargetAudience? @relation(fields: [targetAudienceId], references: [id])

  @@index([companyId])
  @@index([badgeId])
  @@index([triggerEventId])
  @@index([targetAudienceId])
  @@map("badge_rules")
}

model EmployeeBadge {
  id            Int       @id @default(autoincrement())
  companyId     Int
  badgeId       Int
  employeeId    String    @db.VarChar(20)
  awardedBy     Int?
  awardedAt     DateTime  @default(now())
  remarks       String?
  revokedAt     DateTime?
  revokedBy     Int?
  revokedReason String?

  company       Company  @relation(fields: [companyId], references: [id])
  badge         Badge    @relation(fields: [badgeId], references: [id])
  employee      Employee @relation(fields: [employeeId], references: [id])
  awardedByUser AppUser? @relation("BadgeAwardedBy", fields: [awardedBy], references: [id])
  revokedByUser AppUser? @relation("BadgeRevokedBy", fields: [revokedBy], references: [id])

  @@unique([badgeId, employeeId])
  @@index([employeeId])
  @@map("employee_badges")
}

///////////////////////////////////////////////////////////
// LEADERBOARD (Shared Domain)
///////////////////////////////////////////////////////////

model Leaderboard {
  id               Int               @id @default(autoincrement())
  companyId        Int
  name             String            @db.VarChar(150)
  description      String?           @db.Text
  scopeType        LeaderboardScope
  scopeId          Int?
  targetAudienceId Int?
  rankingCriteria  RankingCriteria
  periodType       LeaderboardPeriod @default(ALL_TIME)
  displayLimit     Int               @default(20)
  isActive         Boolean           @default(true)
  createdBy        Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  company        Company            @relation(fields: [companyId], references: [id])
  targetAudience TargetAudience?    @relation(fields: [targetAudienceId], references: [id])
  entries        LeaderboardEntry[]

  @@index([companyId])
  @@index([scopeType, scopeId])
  @@index([targetAudienceId])
  @@map("leaderboards")
}

model LeaderboardEntry {
  id            Int       @id @default(autoincrement())
  companyId     Int
  leaderboardId Int
  employeeId    String    @db.VarChar(20)
  rank          Int
  score         Decimal   @db.Decimal(12, 2)
  previousRank  Int?
  periodStart   DateTime?
  periodEnd     DateTime?
  calculatedAt  DateTime  @default(now())

  company     Company     @relation(fields: [companyId], references: [id])
  leaderboard Leaderboard @relation(fields: [leaderboardId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@unique([leaderboardId, employeeId, periodStart])
  @@index([companyId])
  @@index([leaderboardId, rank])
  @@index([employeeId])
  @@map("leaderboard_entries")
}

// CertificateTemplate excluded — kept as standalone model with its own
// signers/stamps/numbering. Structured relational data doesn't fit this generic pattern.
///////////////////////////////////////////////////////////
// CONFIGURATION & TEMPLATE MANAGEMENT
///////////////////////////////////////////////////////////

model SystemSetting {
  id            Int             @id @default(autoincrement())
  companyId     Int
  category      SettingCategory
  settingKey    String          @db.VarChar(150)
  settingValue  Json
  description   String?         @db.Text
  updatedBy     Int
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id])
  updatedByUser AppUser         @relation(fields: [updatedBy], references: [id])

  @@unique([companyId, settingKey])
  @@index([companyId, category])
  @@map("system_settings")
}

model CourseTemplate {
  id        Int @id @default(autoincrement())
  companyId Int

  name              String  @db.VarChar(255)
  description       String? @db.Text
  shortSummary      String? @db.VarChar(150) // from document
  categoryId        Int
  difficultyLevelId Int

  language                 String? @db.VarChar(20)
  thumbnailUrl             String?
  estimatedDurationMinutes Int?
  targetAudienceText       String? // free-text fallback

  visibility       VisibilityType   @default(COMPANY)
  enrollmentPolicy EnrollmentPolicy @default(OPEN) // OPEN, INVITATION, PAYMENT (or make enum)

  // Completion & Assessment defaults
  passingScore        Decimal  @db.Decimal(5, 2)
  completionThreshold Decimal  @db.Decimal(5, 2) // % of content
  attendanceRequired  Boolean  @default(false)
  minimumAttendance   Decimal? @db.Decimal(5, 2)
  certificateRequired Boolean  @default(true)

  // XP defaults
  baseXpOnCompletion  Int @default(100)
  perfectScoreBonusXp Int @default(50)

  isActive   Boolean @default(true)
  isTemplate Boolean @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company         Company         @relation(fields: [companyId], references: [id])
  category        CourseCategory  @relation(fields: [categoryId], references: [id])
  difficultyLevel DifficultyLevel @relation(fields: [difficultyLevelId], references: [id])
  creator         AppUser         @relation("CourseTemplateCreator", fields: [createdBy], references: [id])
  updater         AppUser?        @relation("CourseTemplateUpdater", fields: [updatedBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@index([categoryId])
  @@index([difficultyLevelId])
  @@map("course_templates")
}

model ProgramTemplate {
  id        Int @id @default(autoincrement())
  companyId Int

  name        String  @db.VarChar(255)
  description String? @db.Text
  categoryId  Int? // ProgramCategory

  programTypeId Int?
  durationWeeks Int?
  visibility    VisibilityType @default(COMPANY)

  isMandatory         Boolean @default(false)
  autoEnroll          Boolean @default(false)
  allowSelfEnrollment Boolean @default(true)
  rollingEnrollment   Boolean @default(false)
  capacity            Int?

  certificateEnabled Boolean @default(true)
  xpEnabled          Boolean @default(true)

  // Default milestone configuration can be stored as JSON or separate table later
  defaultMilestones Json?

  isActive Boolean @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company  Company          @relation(fields: [companyId], references: [id])
  category ProgramCategory? @relation(fields: [categoryId], references: [id])
  creator  AppUser          @relation("ProgramTemplateCreator", fields: [createdBy], references: [id])
  updater  AppUser?         @relation("ProgramTemplateUpdater", fields: [updatedBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@index([categoryId])
  @@map("program_templates")
}

model AssessmentTemplate {
  id        Int @id @default(autoincrement())
  companyId Int

  name             String  @db.VarChar(255)
  description      String? @db.Text
  assessmentTypeId Int
  gradingMethodId  Int

  passingScore     Decimal @db.Decimal(5, 2)
  maxAttempts      Int     @default(2)
  timeLimitMinutes Int?

  randomizeQuestions    Boolean                  @default(false)
  randomizeOptions      Boolean                  @default(false)
  showResultImmediately Boolean                  @default(false)
  allowReview           Boolean                  @default(true)
  showCorrectAnswers    ShowCorrectAnswersTiming

  lockdownBrowser   Boolean @default(false)
  proctoringEnabled Boolean @default(false)

  // Scoring rules
  negativeMarking Decimal? @db.Decimal(3, 2)

  isActive Boolean @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company        @relation(fields: [companyId], references: [id])
  assessmentType AssessmentType @relation(fields: [assessmentTypeId], references: [id])
  gradingMethod  GradingMethod  @relation(fields: [gradingMethodId], references: [id])
  creator        AppUser        @relation("AssessmentTemplateCreator", fields: [createdBy], references: [id])
  updater        AppUser?       @relation("AssessmentTemplateUpdater", fields: [updatedBy], references: [id])

  assessments Assessment[] // actual instances created from this template

  @@unique([companyId, name])
  @@index([companyId])
  @@map("assessment_templates")
}

model SurveyTemplate {
  id               Int              @id @default(autoincrement())
  companyId        Int
  name             String           @db.VarChar(255)
  description      String?          @db.Text
  surveyType       SurveyType
  kirkpatrickLevel KirkpatrickLevel
  isAnonymous      Boolean          @default(false)
  availableDays    Int?
  isActive         Boolean          @default(true)
  createdBy        Int
  updatedBy        Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  company          Company          @relation(fields: [companyId], references: [id])
  creator          AppUser          @relation("SurveyTemplateCreator", fields: [createdBy], references: [id])
  updater          AppUser?         @relation("SurveyTemplateUpdater", fields: [updatedBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("survey_templates")
}

model NotificationTemplate {
  id                  Int                 @id @default(autoincrement())
  companyId           Int
  name                String              @db.VarChar(255)
  description         String?             @db.Text
  channel             NotificationChannel
  eventCode           String              @db.VarChar(100)
  subject             String?             @db.VarChar(255)
  body                String              @db.Text
  variables           Json?
  language            String?             @db.VarChar(20)
  isActive            Boolean             @default(true)
  createdBy           Int
  updatedBy           Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?
  company             Company             @relation(fields: [companyId], references: [id])
  creator             AppUser             @relation("NotificationTemplateCreator", fields: [createdBy], references: [id])
  updater             AppUser?            @relation("NotificationTemplateUpdater", fields: [updatedBy], references: [id])
  notificationEvent   NotificationEvent?  @relation(fields: [notificationEventId], references: [id])
  notificationEventId Int?

  @@unique([companyId, name])
  @@index([companyId])
  @@map("notification_templates")
}

model NotificationModule {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String   @db.VarChar(100) // e.g. "Course", "Program"
  slug        String   @db.VarChar(80) // e.g. "course"
  description String?
  isSystem    Boolean  @default(false) // Protect defaults
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company             @relation(fields: [companyId], references: [id])
  events  NotificationEvent[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@map("notification_modules")
}

model NotificationEvent {
  id          Int     @id @default(autoincrement())
  companyId   Int
  code        String  @db.VarChar(100)
  name        String
  description String?
  moduleId    Int // ← Changed to FK

  isActive Boolean @default(true)

  company   Company                @relation(fields: [companyId], references: [id])
  module    NotificationModule     @relation(fields: [moduleId], references: [id])
  templates NotificationTemplate[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([moduleId])
  @@map("notification_events")
}

model LearningPathTemplate {
  id                    Int       @id @default(autoincrement())
  companyId             Int
  name                  String    @db.VarChar(255)
  description           String?   @db.Text
  estimatedDurationDays Int?
  isMandatory           Boolean   @default(false)
  isActive              Boolean   @default(true)
  createdBy             Int
  updatedBy             Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  company               Company   @relation(fields: [companyId], references: [id])
  creator               AppUser   @relation("LearningPathTemplateCreator", fields: [createdBy], references: [id])
  updater               AppUser?  @relation("LearningPathTemplateUpdater", fields: [updatedBy], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@map("learning_path_templates")
}

model CertificateTemplate {
  id                Int    @id @default(autoincrement())
  companyId         Int
  courseVersionId   Int?
  learningProgramId Int?
  name              String @db.VarChar(255)

  certificateTypeId Int // ← Changed to FK

  templateFile          String?
  certificateIdPattern  String                 @db.VarChar(100)
  validityMonths        Int?
  sealImage             String?
  qrVerificationEnabled Boolean                @default(true)
  backgroundImage       String?
  status                ContentLifecycleStatus

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  courseVersion   CourseVersion?   @relation(fields: [courseVersionId], references: [id])
  learningProgram LearningProgram? @relation(fields: [learningProgramId], references: [id])
  certificateType CertificateType  @relation(fields: [certificateTypeId], references: [id])

  createdByUser AppUser  @relation("CertTemplateCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser? @relation("CertTemplateUpdatedBy", fields: [updatedBy], references: [id])

  signers      CertificateTemplateSigner[]
  certificates Certificate[]

  @@index([companyId])
  @@index([certificateTypeId])
  @@map("certificate_templates")
}

model CertificateTemplateSigner {
  id           Int                 @id @default(autoincrement())
  companyId    Int
  templateId   Int
  employeeId   String              @db.VarChar(20)
  displayOrder Int
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  company      Company             @relation(fields: [companyId], references: [id])
  template     CertificateTemplate @relation(fields: [templateId], references: [id])
  employee     Employee            @relation(fields: [employeeId], references: [id])

  @@unique([templateId, displayOrder])
  @@unique([templateId, employeeId])
  @@map("certificate_template_signers")
}

///////////////////////////////////////////////////////////
// Workflow Management (Shared Domain)
///////////////////////////////////////////////////////////

model ApprovalWorkflow {
  id          Int                @id @default(autoincrement())
  companyId   Int
  name        String             @db.VarChar(255)
  entityType  WorkflowEntityType
  description String?            @db.Text
  isDefault   Boolean            @default(false)
  isSystem    Boolean            @default(false)
  isActive    Boolean            @default(true)

  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company Company  @relation(fields: [companyId], references: [id])
  creator AppUser  @relation("ApprovalWorkflowCreator", fields: [createdBy], references: [id])
  updater AppUser? @relation("ApprovalWorkflowUpdater", fields: [updatedBy], references: [id])

  steps     ApprovalWorkflowStep[]
  instances ApprovalWorkflowInstance[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("approval_workflows")
}

model ApprovalWorkflowStep {
  id            Int @id @default(autoincrement())
  companyId     Int
  workflowId    Int
  approvalOrder Int

  // Designation of who approves this step
  approverRoleId     Int? // FK to EMS AppRole
  approverEmployeeId String? @db.VarChar(20)

  isRequired  Boolean @default(true)
  autoApprove Boolean @default(false)
  timeoutDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company            @relation(fields: [companyId], references: [id])
  workflow     ApprovalWorkflow   @relation(fields: [workflowId], references: [id])
  approverRole AppRole?           @relation(fields: [approverRoleId], references: [id])
  approver     Employee?          @relation(fields: [approverEmployeeId], references: [id])
  decisions    ApprovalDecision[]

  @@unique([workflowId, approvalOrder])
  @@index([companyId])
  @@index([approverRoleId])
  @@map("approval_workflow_steps")
}

model ApprovalWorkflowInstance {
  id         Int                @id @default(autoincrement())
  companyId  Int
  workflowId Int
  entityType WorkflowEntityType

  // Polymorphic links to what is being approved
  courseVersionId       Int?
  learningProgramId     Int?
  trainingNeedRequestId Int? // ← ADDED for TNA

  status        WorkflowInstanceStatus @default(DRAFT)
  submittedBy   Int?
  submittedAt   DateTime?
  completedAt   DateTime?
  latestComment String?                @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company             Company              @relation(fields: [companyId], references: [id])
  workflow            ApprovalWorkflow     @relation(fields: [workflowId], references: [id])
  courseVersion       CourseVersion?       @relation(fields: [courseVersionId], references: [id])
  learningProgram     LearningProgram?     @relation(fields: [learningProgramId], references: [id])
  trainingNeedRequest TrainingNeedRequest? @relation(fields: [trainingNeedRequestId], references: [id])
  submittedByUser     AppUser?             @relation("ApprovalInstanceSubmittedBy", fields: [submittedBy], references: [id])
  decisions           ApprovalDecision[]

  @@index([companyId])
  @@index([workflowId])
  @@index([courseVersionId])
  @@index([learningProgramId])
  @@index([trainingNeedRequestId])
  @@map("approval_workflow_instances")
}

model ApprovalDecision {
  id             Int            @id @default(autoincrement())
  companyId      Int
  instanceId     Int
  workflowStepId Int
  status         ApprovalStatus
  comment        String?        @db.Text
  decidedBy      Int?
  decidedAt      DateTime       @default(now())

  company       Company                  @relation(fields: [companyId], references: [id])
  instance      ApprovalWorkflowInstance @relation(fields: [instanceId], references: [id])
  workflowStep  ApprovalWorkflowStep     @relation(fields: [workflowStepId], references: [id])
  decidedByUser AppUser?                 @relation("ApprovalDecisionMadeBy", fields: [decidedBy], references: [id])

  @@unique([instanceId, workflowStepId])
  @@index([companyId])
  @@map("approval_decisions")
}
