///////////////////////////////////////////////////////////
// EMS REFERENCE MODELS
// These tables already exist inside EMS.
// LMS only references them and does not have ownership or write access to these models
// This is because the LMS is a separate microservice and does not have direct db access to the EMS database.
// The two services communicates via message queue (RabbitMQ)
///////////////////////////////////////////////////////////

model Company {
  id           Int       @id
  companyCode  String    @unique @map("company_code") @db.VarChar(20)
  name         String    @db.VarChar(200)
  logoUrl      String?   @map("logo_url") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  //Internal LMS Relations
  courses                    Course[]
  courseVersions             CourseVersion[]
  courseTags                 CourseTag[]
  courseTagMappings          CourseTagMapping[]
  courseAnnouncements        CourseAnnouncement[]
  courseCategories           CourseCategory[]
  instructorRoles            InstructorRole[]
  courseInstructors          CourseInstructor[]
  courseSkills               CourseSkill[]
  skills                     Skill[]
  employeeSkillAssessments   EmployeeSkillAssessment[]
  coursePrerequisites        CoursePrerequisite[]
  chapterPrerequisites       ChapterPrerequisite[]
  courseChapters             CourseChapter[]
  courseContents             CourseContent[]
  contentFiles               ContentFile[]
  bookmarks                  Bookmark[]
  courseReviews              CourseReview[]
  learningPrograms           LearningProgram[]
  programTypes               ProgramType[]
  programCourses             ProgramCourse[]
  programCohorts             ProgramCohort[]
  programEnrollments         ProgramEnrollment[]
  programMilestones          ProgramMilestone[]
  programTasks               ProgramTask[]
  programTaskSubmissions     ProgramTaskSubmission[]
  enrollments                Enrollment[]
  enrollmentRules            EnrollmentRule[]
  learningProgresses         LearningProgress[]
  lessonProgresses           LessonProgress[]
  learningSessions           LearningSession[]
  enrollmentActivityLogs     EnrollmentActivityLog[]
  waitlistEntries            WaitlistEntry[]
  courseCompletions          CourseCompletion[]
  assessments                Assessment[]
  assessmentBlueprints       AssessmentBlueprint[]
  assessmentQuestions        AssessmentQuestion[]
  questions                  Question[]
  questionVersions           QuestionVersion[]
  questionOptions            QuestionOption[]
  assessmentAttempts         AssessmentAttempt[]
  assessmentAnswers          AssessmentAnswer[]
  certificateTemplates       CertificateTemplate[]
  certificateTemplateSigners CertificateTemplateSigner[]
  certificates               Certificate[]
  certificateVerifications   CertificateVerification[]
  externalCertificates       ExternalCertificate[]
  externalProviders          ExternalProvider[]
  liveSessions               LiveSession[]
  liveSessionInstructors     LiveSessionInstructor[]
  liveSessionAttendances     LiveSessionAttendance[]
  liveSessionWaitlists       LiveSessionWaitlist[]
  surveys                    Survey[]
  surveyQuestions            SurveyQuestion[]
  surveyResponses            SurveyResponse[]
  surveyAnswers              SurveyAnswer[]
  effectivenessWeightConfigs EffectivenessWeightConfig[]
  trainingEffectivenesses    TrainingEffectiveness[]
  tnaRequestTypeConfigs      TnaRequestTypeConfig[]
  tnaApprovalWorkflowSteps   TnaApprovalWorkflowStep[]
  trainingNeedRequests       TrainingNeedRequest[]
  trainingNeedSkills         TrainingNeedSkill[]
  tnaApprovals               TnaApproval[]
  tnaRecommendations         TnaRecommendation[]
  tnaRecommendationSkills    TnaRecommendationSkill[]
  xpRules                    XpRule[]
  xpTransactions             XpTransaction[]
  learningLevels             LearningLevel[]
  badges                     Badge[]
  badgeRules                 BadgeRule[]
  employeeBadges             EmployeeBadge[]
  systemSettings             SystemSetting[]
  programCategories          ProgramCategory[]
  courseTemplates            CourseTemplate[]
  programTemplates           ProgramTemplate[]
  assessmentTemplates        AssessmentTemplate[]
  surveyTemplates            SurveyTemplate[]
  notificationTemplates      NotificationTemplate[]
  notificationEvents         NotificationEvent[]
  learningPathTemplates      LearningPathTemplate[]
  approvalWorkflows          ApprovalWorkflow[]
  approvalWorkflowInstances  ApprovalWorkflowInstance[]
  approvalDecisions          ApprovalDecision[]
  programCompletions         ProgramCompletion[]
  programMilestoneProgresses ProgramMilestoneProgress[]
  relatedCourses             RelatedCourse[]
  courseFAQs                 CourseFAQ[]
  targetAudiences            TargetAudience[]
  topics                     Topic[]
  employees                  Employee[]
  appUsers                   AppUser[]
  departments                Department[]
  jobTitles                  JobTitle[]
  jobLevels                  JobLevel[]
  appRoles                   AppRole[]
  lmsPermissions             LmsPermission[]
  lmsRolePermissions         LmsRolePermission[]

  @@map("company")
}

model Employee {
  id           String    @id @db.VarChar(20)
  companyId    Int       @map("company_id")
  fullName     String    @map("full_name") @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  // To handle TargetAudience matching rules locally
  departmentId Int? @map("department_id")
  jobTitleId   Int? @map("job_title_id")

  // Internal LMS Relations
  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id])

  enrollments                Enrollment[]
  courses                    Course[]
  ownedCourses               Course[]                    @relation("CourseOwner")
  courseInstructors          CourseInstructor[]
  employeeSkillAssessments   EmployeeSkillAssessment[]
  bookmarks                  Bookmark[]
  learningPrograms           LearningProgram[]
  programEnrollments         ProgramEnrollment[]
  programTaskSubmissions     ProgramTaskSubmission[]
  certificateTemplateSigners CertificateTemplateSigner[]
  certificateVerifications   CertificateVerification[]
  externalCertificates       ExternalCertificate[]
  liveSessionInstructors     LiveSessionInstructor[]
  surveyResponses            SurveyResponse[]
  trainingNeedRequests       TrainingNeedRequest[]
  tnaApprovals               TnaApproval[]
  xpTransactions             XpTransaction[]
  employeeBadges             EmployeeBadge[]
  approvalWorkflowSteps      ApprovalWorkflowStep[]
  appUsers                   AppUser[]

  @@map("employee")
}

model AppUser {
  id         Int     @id
  companyId  Int
  employeeId String? @db.VarChar(20)

  email        String    @db.VarChar(150)
  roleId       Int? // FK to AppRole (synced from EMS) — LMS-specific permissions resolved via LmsRolePermission, not stored here
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company  Company   @relation(fields: [companyId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  role     AppRole?  @relation(fields: [roleId], references: [id])

  createdCourses              Course[]                    @relation("CourseCreatedBy")
  updatedCourses              Course[]                    @relation("CourseUpdatedBy")
  createdCourseVersions       CourseVersion[]             @relation("CourseVersionCreatedBy")
  updatedCourseVersions       CourseVersion[]             @relation("CourseVersionUpdatedBy")
  publishedCourseVersions     CourseVersion[]             @relation("CourseVersionPublishedBy")
  approvedCourseVersions      CourseVersion[]             @relation("CourseVersionApprovedBy")
  createdCourseCategories     CourseCategory[]            @relation("CourseCategoryCreatedBy")
  updatedCourseCategories     CourseCategory[]            @relation("CourseCategoryUpdatedBy")
  createdCourseTags           CourseTag[]                 @relation("CourseTagCreatedBy")
  updatedCourseTags           CourseTag[]                 @relation("CourseTagUpdatedBy")
  createdCourseFAQ            CourseFAQ[]                 @relation("CourseFAQCreatedBy")
  updatedCourseFAQ            CourseFAQ[]                 @relation("CourseFAQUpdatedBy")
  createdCourseAnnouncements  CourseAnnouncement[]        @relation("CourseAnnouncementCreatedBy")
  updatedCourseAnnouncements  CourseAnnouncement[]        @relation("CourseAnnouncementUpdatedBy")
  createdCertTemplates        CertificateTemplate[]       @relation("CertTemplateCreatedBy")
  updatedCertTemplates        CertificateTemplate[]       @relation("CertTemplateUpdatedBy")
  createdLiveSessions         LiveSession[]               @relation("LiveSessionCreatedBy")
  updatedLiveSessions         LiveSession[]               @relation("LiveSessionUpdatedBy")
  createdXpRules              XpRule[]                    @relation("XpRuleCreatedBy")
  updatedXpRules              XpRule[]                    @relation("XpRuleUpdatedBy")
  createdAssessments          Assessment[]                @relation("AssessmentCreatedBy")
  updatedAssessments          Assessment[]                @relation("AssessmentUpdatedBy")
  gradedAttempts              AssessmentAttempt[]         @relation("GradedBy")
  createdPrograms             LearningProgram[]           @relation("ProgramCreatedBy")
  updatedPrograms             LearningProgram[]           @relation("ProgramUpdatedBy")
  reviewedSubmissions         ProgramTaskSubmission[]     @relation("TaskReviewer")
  assignedEnrollments         Enrollment[]                @relation("EnrollmentAssignedBy")
  approvedEnrollments         Enrollment[]                @relation("EnrollmentApprovedBy")
  enrollmentRuleCreator       EnrollmentRule[]            @relation("EnrollmentRuleCreator")
  enrollmentRuleUpdater       EnrollmentRule[]            @relation("EnrollmentRuleUpdater")
  awardedBadges               EmployeeBadge[]             @relation("BadgeAwardedBy")
  revokedBadges               EmployeeBadge[]             @relation("BadgeRevokedBy")
  createdSurveys              Survey[]                    @relation("SurveyCreatedBy")
  updatedSurveys              Survey[]                    @relation("SurveyUpdatedBy")
  createdApprovalWorkflows    ApprovalWorkflow[]          @relation("ApprovalWorkflowCreator")
  updatedApprovalWorkflows    ApprovalWorkflow[]          @relation("ApprovalWorkflowUpdater")
  createdProgramCategory      ProgramCategory[]           @relation("ProgramCategoryCreator")
  updatedProgramCategory      ProgramCategory[]           @relation("ProgramCategoryUpdater")
  createdCourseTemplate       CourseTemplate[]            @relation("CourseTemplateCreator")
  updatedCourseTemplate       CourseTemplate[]            @relation("CourseTemplateUpdater")
  createdProgramTemplate      ProgramTemplate[]           @relation("ProgramTemplateCreator")
  updatedProgramTemplate      ProgramTemplate[]           @relation("ProgramTemplateUpdater")
  createdAssessmentTemplate   AssessmentTemplate[]        @relation("AssessmentTemplateCreator")
  updatedAssessmentTemplate   AssessmentTemplate[]        @relation("AssessmentTemplateUpdater")
  createdNotificationTemplate NotificationTemplate[]      @relation("NotificationTemplateCreator")
  updatedNotificationTemplate NotificationTemplate[]      @relation("NotificationTemplateUpdater")
  createdLearningPathTemplate LearningPathTemplate[]      @relation("LearningPathTemplateCreator")
  updatedLearningPathTemplate LearningPathTemplate[]      @relation("LearningPathTemplateUpdater")
  createdSurveyTemplate       SurveyTemplate[]            @relation("SurveyTemplateCreator")
  updatedSurveyTemplate       SurveyTemplate[]            @relation("SurveyTemplateUpdater")
  courseInstructors           CourseInstructor[]
  employeeSkillAssessments    EmployeeSkillAssessment[]
  contentFiles                ContentFile[]
  courseReviews               CourseReview[]
  programEnrollments          ProgramEnrollment[]
  enrollmentActivityLogs      EnrollmentActivityLog[]
  questions                   Question[]
  questionVersions            QuestionVersion[]
  assessmentAnswers           AssessmentAnswer[]
  submittedApprovalInstances  ApprovalWorkflowInstance[]  @relation("ApprovalInstanceSubmittedBy")
  approvalDecisions           ApprovalDecision[]          @relation("ApprovalDecisionMadeBy")
  effectivenessWeightConfigs  EffectivenessWeightConfig[]
  systemSettings              SystemSetting[]

  @@index([companyId])
  @@index([roleId])
  @@map("app_user")
}

model Department {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?

  company              Company               @relation(fields: [companyId], references: [id])
  employees            Employee[]
  trainingNeedRequests TrainingNeedRequest[]
  targetAudiences      TargetAudience[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("departments")
}

model JobTitle {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?

  company                  Company                   @relation(fields: [companyId], references: [id])
  employees                Employee[]
  tnaApprovalWorkflowSteps TnaApprovalWorkflowStep[]
  trainingNeedRequests     TrainingNeedRequest[]
  targetAudiences          TargetAudience[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("job_titles")
}

model JobLevel {
  id           Int       @id @default(autoincrement())
  companyId    Int
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?

  company         Company          @relation(fields: [companyId], references: [id])
  targetAudiences TargetAudience[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("job_level")
}

// This model is for LMS-specific permissions not stored in EMS database
model LmsPermission {
  id          Int     @id @default(autoincrement())
  companyId   Int
  code        String  @db.VarChar(100) // e.g. "course.create", "course.publish", "tna.approve_level_1"
  description String?
  module      String  @db.VarChar(50) // groups by feature area: "course", "tna", "assessment", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company             @relation(fields: [companyId], references: [id])
  rolePermissions LmsRolePermission[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([module])
  @@map("lms_permissions")
}

model LmsRolePermission {
  id           Int @id @default(autoincrement())
  companyId    Int
  appRoleId    Int
  permissionId Int

  createdAt DateTime @default(now())

  company    Company       @relation(fields: [companyId], references: [id])
  appRole    AppRole       @relation(fields: [appRoleId], references: [id])
  permission LmsPermission @relation(fields: [permissionId], references: [id])

  @@unique([appRoleId, permissionId])
  @@index([companyId])
  @@map("lms_role_permissions")
}

model AppRole {
  id           Int       @id
  companyId    Int
  name         String    @db.VarChar(100)
  description  String?
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime?

  company         Company             @relation(fields: [companyId], references: [id])
  appUsers        AppUser[]
  lmsPermissions  LmsRolePermission[]
  targetAudiences TargetAudience[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("app_role")
}

///////////////////////////////////////////////////////////
// COURSE MANAGEMENT
///////////////////////////////////////////////////////////

model Course {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  code               String?  @db.VarChar(50)
  title              String   @db.VarChar(255)
  description        String?  @db.Text
  thumbnailUrl       String?
  shortSummary       String?  @db.VarChar(150)
  categoryId         Int
  language           String?  @db.VarChar(20)
  learningObjectives String[]
  estimatedHours     Decimal?
  keywords           String[]

  // Learner-facing point of contact for questions about this course.
  // Distinct from createdBy (who authored it) and CourseInstructor
  // (version-scoped, can be multiple people).
  contactEmployeeId String? @db.VarChar(20)
  ownerEmployeeId   String? @db.VarChar(20)

  // PUBLIC = no visibility restriction WITHIN this company; still
  // scoped by companyId like every other table, not cross-tenant.
  visibility       VisibilityType   @default(COMPANY)
  enrollmentPolicy EnrollmentPolicy @default(OPEN)

  // Coarse container-level flag only. Authoritative workflow state is
  // CourseVersion.status + CourseVersion.approvalStatus.
  status            CourseStatus         @default(DRAFT)
  targetAudiences   TargetAudience[]
  isTemplate        Boolean              @default(false)
  sourceTemplateId  Int?
  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  company           Company              @relation(fields: [companyId], references: [id])
  category          CourseCategory       @relation(fields: [categoryId], references: [id])
  contactEmployee   Employee?            @relation(fields: [contactEmployeeId], references: [id])
  ownerEmployee     Employee?            @relation("CourseOwner", fields: [ownerEmployeeId], references: [id])
  createdByUser     AppUser              @relation("CourseCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     AppUser?             @relation("CourseUpdatedBy", fields: [updatedBy], references: [id])
  sourceTemplate    Course?              @relation("TemplateInstances", fields: [sourceTemplateId], references: [id])
  templateInstances Course[]             @relation("TemplateInstances")
  versions          CourseVersion[]
  bookmarks         Bookmark[]
  reviews           CourseReview[]
  prerequisites     CoursePrerequisite[] @relation("CoursePrerequisites")
  requiredBy        CoursePrerequisite[] @relation("RequiredCourses")
  skills            CourseSkill[]
  tags              CourseTagMapping[]
  courseFAQs        CourseFAQ[]
  relatedFrom       RelatedCourse[]      @relation("CourseRelations")
  relatedTo         RelatedCourse[]      @relation("RelatedTo")

  @@unique([companyId, code])
  @@unique([companyId, categoryId, title])
  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([companyId, status])
  @@index([visibility])
  @@map("courses")
}

model CourseVersion {
  id        Int @id @default(autoincrement())
  companyId Int
  courseId  Int

  // Version fields - integer-based for proper sorting
  majorVersion Int     @default(1) // e.g. 1, 2, 3
  minorVersion Int     @default(0) // e.g. 0, 1, 2
  versionLabel String? @db.VarChar(50) // cosmetic only: "beta", "rc1", "hotfix"
  changeLog    String? //Very useful for version history.

  // Course configuration — authoritative for enrollability.
  // Course.status is informational/catalog-filtering only; never gate
  // enrollment on Course.status alone — always check here.
  status                   VersionStatus   @default(DRAFT)
  approvalStatus           ApprovalStatus  @default(PENDING)
  difficultyLevel          DifficultyLevel
  estimatedDurationMinutes Int?
  passingScore             Decimal         @db.Decimal(5, 2)
  completionThreshold      Decimal         @db.Decimal(5, 2)
  certificateRequired      Boolean         @default(true)
  attendanceRequired       Boolean         @default(false)
  minimumAttendance        Decimal?        @db.Decimal(5, 2)
  allowDownload            Boolean
  capacity                 Int?
  isCurrent                Boolean         @default(false) //Makes fetching latest version easy.
  previewAvailable         Boolean

  // Publishing metadata
  publishDate DateTime?
  publishedBy Int?

  // Approval metadata — was missing; approvalStatus had no record of
  // who made the decision or when.
  approvedBy Int?
  approvedAt DateTime?

  // Audit fields
  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company             Company              @relation(fields: [companyId], references: [id])
  course              Course               @relation(fields: [courseId], references: [id])
  createdByUser       AppUser              @relation("CourseVersionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser       AppUser?             @relation("CourseVersionUpdatedBy", fields: [updatedBy], references: [id])
  publishedByUser     AppUser?             @relation("CourseVersionPublishedBy", fields: [publishedBy], references: [id])
  approvedByUser      AppUser?             @relation("CourseVersionApprovedBy", fields: [approvedBy], references: [id])
  chapters            CourseChapter[]
  instructors         CourseInstructor[]
  enrollments         Enrollment[]
  assessments         Assessment[]
  certificateTemplate CertificateTemplate?
  liveSessions        LiveSession[]        @relation("CourseVersionLiveSessions")
  surveys             Survey[]
  announcements       CourseAnnouncement[]
  programCourses      ProgramCourse[]
  tnaRecommendations  TnaRecommendation[]
  enrollmentRules     EnrollmentRule[]     @relation("EnrollmentRuleCourseVersion")
  //courseRelatedTo     RelatedCourse[]            @relation("RelatedTo")

  approvalInstances ApprovalWorkflowInstance[]
  xpRules           XpRule[]
  programTasks      ProgramTask[]
  courseFAQs        CourseFAQ[]

  // One course can have only one version per major.minor combination
  @@unique([courseId, majorVersion, minorVersion])
  @@index([companyId])
  @@index([courseId, status])
  @@index([publishDate])
  @@map("course_versions")
}

