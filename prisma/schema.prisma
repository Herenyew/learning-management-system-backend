}

model CourseInstructor {
  id              Int @id @default(autoincrement())
  companyId       Int
  courseVersionId Int

  // Internal instructor (Employee) OR external instructor (AppUser) —
  // exactly one of these two must be set, never both, never neither.
  // Not enforceable by Prisma/Postgres directly; must be validated in
  // application logic on every write to this table.
  employeeId String? @db.VarChar(20)
  appUserId  Int?

  roleId     Int
  isPrimary  Boolean   @default(true)
  assignedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  courseVersion CourseVersion  @relation(fields: [courseVersionId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  appUser       AppUser?       @relation(fields: [appUserId], references: [id])
  role          InstructorRole @relation(fields: [roleId], references: [id])

  @@index([companyId])
  @@index([courseVersionId])
  @@index([employeeId])
  @@index([appUserId])
  @@map("course_instructors")
}

model CourseSkill {
