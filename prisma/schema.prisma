  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company               Company               @relation(fields: [companyId], references: [id])
  department            Department?           @relation(fields: [departmentId], references: [id])
  jobTitle              JobTitle?             @relation(fields: [jobTitleId], references: [id])
  jobLevel              JobLevel?             @relation(fields: [jobLevelId], references: [id])
  appRole               AppRole?              @relation(fields: [appRoleId], references: [id])
  course                Course?               @relation(fields: [courseId], references: [id])
  courseId              Int?
  learningProgram       LearningProgram?      @relation(fields: [learningProgramId], references: [id])
  learningProgramId     Int?
  enrollmentRules       EnrollmentRule[]
  assessment            Assessment?           @relation(fields: [assessmentId], references: [id])
  assessmentId          Int?
  certificateTemplate   CertificateTemplate?  @relation(fields: [certificateTemplateId], references: [id])
  certificateTemplateId Int?
  liveSession           LiveSession?          @relation(fields: [liveSessionId], references: [id])
  liveSessionId         Int?
  trainingNeedRequests  TrainingNeedRequest[]
  tnaRecommendations    TnaRecommendation[]
  xpRules               XpRule[]
  badgeRules            BadgeRule[]
  courseTemplate        CourseTemplate?       @relation(fields: [courseTemplateId], references: [id])
  courseTemplateId      Int?
  programTemplate       ProgramTemplate?      @relation(fields: [programTemplateId], references: [id])
  programTemplateId     Int?
  assessmentTemplate    AssessmentTemplate?   @relation(fields: [assessmentTemplateId], references: [id])
  assessmentTemplateId  Int?

