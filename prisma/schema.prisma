enum WorkflowEntityType {
  COURSE
  COURSE_VERSION
  LEARNING_PROGRAM
  TNA_REQUEST
  CERTIFICATE
  LIVE_SESSION
}

enum LeaderboardScope {
  COMPANY
  DEPARTMENT
  PROGRAM
  COURSE
  GLOBAL
}

enum RankingCriteria {
  XP
  COURSE_COMPLETIONS
  PROGRAM_COMPLETIONS
  CERTIFICATES
  ASSESSMENT_SCORE
}

enum LeaderboardPeriod {
  ALL_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

enum QuestionAnswerStructure {
  OPTION_BASED
  MATCHING_PAIR_BASED
  FREE_TEXT
}

enum TargetAudienceEntityType {
  COURSE
  LEARNING_PROGRAM
  ASSESSMENT
  CERTIFICATE_TEMPLATE
  LIVE_SESSION
  COURSE_TEMPLATE
  PROGRAM_TEMPLATE
  ASSESSMENT_TEMPLATE
}

enum ScormTrackingMode {
  COMPLETION_ONLY
  SCORE_ONLY
  COMPLETION_AND_SCORE
  TIME_ONLY
}

enum ShowCorrectAnswersTiming {
  IMMEDIATELY
  NEVER
  AFTER_SUBMIT
}

enum TaskLinkedEntity {
  COURSE_VERSION
  COURSE_CONTENT
  ASSESSMENT
  LIVE_SESSION
  SURVEY
