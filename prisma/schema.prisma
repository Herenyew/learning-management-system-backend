// =======================================================
// Learning Management System (LMS)
// Prisma Schema
//
// Database: PostgreSQL
// ORM: Prisma
//
// Architecture:
// EMS Database (Existing)
//      └── Employee
//      └── AppUser
//      └── Company
//
// LMS Database (New)
// =======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////
// ENUMS
///////////////////////////////////////////////////////////

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VisibilityType {
  PUBLIC
  COMPANY
  ENROLLED_ONLY
  INVITATION_ONLY
}

enum EnrollmentPolicy {
  OPEN
  INVITATION_ONLY
  PAYMENT_REQUIRED
}

