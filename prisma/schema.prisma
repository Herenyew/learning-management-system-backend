model CourseCategory {
  id        Int @id @default(autoincrement())
  companyId Int

  // Core fields
  name        String  @db.VarChar(100)
  description String? @db.Text
  slug        String  @db.VarChar(120)

  // Display & Organization
  color        String? @db.VarChar(20)
  icon         String? @db.VarChar(50)
  displayOrder Int     @default(0)

  // Hierarchy support. NOTE: nothing at the DB level prevents a cycle
  // (A -> B -> A) — must be checked in application logic on every
  // write that sets parentId, or category-tree UIs risk an infinite loop.
  parentId Int?
  parent   CourseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryHierarchy")

  // Status & Visibility — independent flags by design. isActive=false
  // does NOT automatically imply isVisible=false; check both explicitly
  // wherever category visibility is decided.
  isActive  Boolean @default(true)
  isVisible Boolean @default(true)

  // Metadata
  createdBy Int?
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company         Company          @relation(fields: [companyId], references: [id])
  createdByUser   AppUser?         @relation("CourseCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   AppUser?         @relation("CourseCategoryUpdatedBy", fields: [updatedBy], references: [id])
  courses         Course[]
  courseTemplates CourseTemplate[]

  // Constraints & Indexes
  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([parentId])
  @@index([isActive, isVisible])
  @@index([displayOrder])
  @@map("course_categories")
}

model InstructorRole {
