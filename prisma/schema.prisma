  description String?           @db.Text
  color       String?           @db.VarChar(20)
  isActive    Boolean           @default(true)
  createdBy   Int
  updatedBy   Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  company     Company           @relation(fields: [companyId], references: [id])
  creator     AppUser           @relation("ProgramCategoryCreator", fields: [createdBy], references: [id])
  updater     AppUser?          @relation("ProgramCategoryUpdater", fields: [updatedBy], references: [id])
