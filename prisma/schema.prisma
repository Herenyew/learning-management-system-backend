}

enum CertificateIssuanceType {
  COURSE_COMPLETION
  PROGRAM_COMPLETION
  MANUAL // admin-issued — no underlying completion record (e.g. service-recognition certificates, legacy/backfilled paper certificates, external training awarded outside the LMS's own tracking)
}

enum RuleOperator {
  AND
  OR
}

///////////////////////////////////////////////////////////
// EMS REFERENCE MODELS
// These tables already exist inside EMS.
// LMS only references them and does not have ownership or write access to these models
// This is because the LMS is a separate microservice and does not have direct db access to the EMS database.
// The two services communicates via message queue (RabbitMQ)
///////////////////////////////////////////////////////////

model Company {
  id           Int       @id
  companyCode  String    @unique @map("company_code") @db.VarChar(20)
  name         String    @db.VarChar(200)
  logoUrl      String?   @map("logo_url") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  // Shared EMS Entity LMS Projections
  employees   Employee[]
  appUsers    AppUser[]
  departments Department[]
  jobTitles   JobTitle[]
  jobLevels   JobLevel[]
  appRoles    AppRole[]

  // Internal LMS Relations
  courses                    Course[]
  courseVersions             CourseVersion[]
  courseTags                 CourseTag[]
  courseTagMappings          CourseTagMapping[]
  courseAnnouncements        CourseAnnouncement[]
  courseCategories           CourseCategory[]
  instructorRoles            InstructorRole[]
  courseInstructors          CourseInstructor[]
  courseSkills               CourseSkill[]
  skills                     Skill[]
  employeeSkillAssessments   EmployeeSkillAssessment[]
  coursePrerequisites        CoursePrerequisite[]
  chapterPrerequisites       ChapterPrerequisite[]
  courseChapters             CourseChapter[]
  courseContents             CourseContent[]
  contentFiles               StoredFile[]
  bookmarks                  Bookmark[]
  courseReviews              CourseReview[]
  learningPrograms           LearningProgram[]
  programTypes               ProgramType[]
  programCourses             ProgramCourse[]
  programCohorts             ProgramCohort[]
  programEnrollments         ProgramEnrollment[]
  programMilestones          ProgramMilestone[]
  programTasks               ProgramTask[]
  submissions                Submission[]
  enrollments                Enrollment[]
  enrollmentRules            EnrollmentRule[]
  learningProgresses         LearningProgress[]
  lessonProgresses           LessonProgress[]
  learningSessions           LearningSession[]
  enrollmentActivityLogs     EnrollmentActivityLog[]
  waitlistEntries            WaitlistEntry[]
  courseCompletions          CourseCompletion[]
  assessments                Assessment[]
  assessmentBlueprints       AssessmentBlueprint[]
  assessmentQuestions        AssessmentQuestion[]
  questions                  Question[]
  questionVersions           QuestionVersion[]
  questionOptions            QuestionOption[]
  assessmentAttempts         AssessmentAttempt[]
  assessmentAnswers          AssessmentAnswer[]
  certificateTemplates       CertificateTemplate[]
  certificateTemplateSigners CertificateTemplateSigner[]
  certificates               Certificate[]
  certificateVerifications   CertificateVerification[]
  externalCertificates       ExternalCertificate[]
  externalProviders          ExternalProvider[]
  liveSessions               LiveSession[]
  liveSessionInstructors     LiveSessionInstructor[]
  liveSessionAttendances     LiveSessionAttendance[]
  liveSessionWaitlists       LiveSessionWaitlist[]
  surveys                    Survey[]
  surveyQuestions            SurveyQuestion[]
  surveyResponses            SurveyResponse[]
  surveyAnswers              SurveyAnswer[]
  effectivenessWeightConfigs EffectivenessWeightConfig[]
  trainingEffectivenesses    TrainingEffectiveness[]
  tnaRequestTypeConfigs      TnaRequestTypeConfig[]
  trainingNeedRequests       TrainingNeedRequest[]
  trainingNeedSkills         TrainingNeedSkill[]
  tnaRecommendations         TnaRecommendation[]
  tnaRecommendationSkills    TnaRecommendationSkill[]
  xpRules                    XpRule[]
  xpTransactions             XpTransaction[]
  learningLevels             LearningLevel[]
  badges                     Badge[]
  badgeRules                 BadgeRule[]
  employeeBadges             EmployeeBadge[]
  systemSettings             SystemSetting[]
  programCategories          ProgramCategory[]
  courseTemplates            CourseTemplate[]
  programTemplates           ProgramTemplate[]
  assessmentTemplates        AssessmentTemplate[]
  surveyTemplates            SurveyTemplate[]
  notificationTemplates      NotificationTemplate[]
  notificationEvents         NotificationEvent[]
  learningPathTemplates      LearningPathTemplate[]
  approvalWorkflows          ApprovalWorkflow[]
  approvalWorkflowInstances  ApprovalWorkflowInstance[]
  approvalDecisions          ApprovalDecision[]
  programCompletions         ProgramCompletion[]
  programMilestoneProgresses ProgramMilestoneProgress[]
  relatedCourses             RelatedCourse[]
  courseFAQs                 CourseFAQ[]
  topics                     Topic[]
  lmsPermissions             LmsPermission[]
  lmsRolePermissions         LmsRolePermission[]
  submissionPeerReviews      SubmissionPeerReview[]
  audienceGroupRules         AudienceGroupRule[]
  audienceGroups             AudienceGroup[]
  targetAudiences            TargetAudience[]
  difficultyLevels           DifficultyLevel[]
  taskTypes                  TaskType[]
  programTags                ProgramTag[]
  programTagMappings         ProgramTagMapping[]
  enrollmentRuleTypes        EnrollmentRuleType[]
  gradingMethods             GradingMethod[]
  assessmentTypes            AssessmentType[]
  questionBanks              QuestionBank[]
  questionTypes              QuestionType[]
  questionMatchingPairs      QuestionMatchingPair[]
  assessmentAnswerOptions    AssessmentAnswerOption[]
  assessmentAnswerMatches    AssessmentAnswerMatch[]
  certificateTypes           CertificateType[]
  credentialSources          CredentialSource[]
  providerTypes              ProviderType[]
  meetingProviders           MeetingProvider[]
  attendanceMethods          AttendanceMethod[]
  surveyQuestionTypes        SurveyQuestionType[]
  fundingTypes               FundingType[]
  trainingFormats            TrainingFormat[]
  tnaEmployees               TnaEmployee[]
  xpRuleCategories           XpRuleCategory[]
  xpTriggerEvents            XpTriggerEvent[]
  leaderboards               Leaderboard[]
  leaderboardEntries         LeaderboardEntry[]
  notificationModules        NotificationModule[]
  approvalWorkflowSteps      ApprovalWorkflowStep[]
  badgeCategories            BadgeCategory[]
  assessmentAttemptRules     AssessmentAttemptRule[]

  @@map("company")
}

model Employee {
  id           String    @id @db.VarChar(20)
  companyId    Int       @map("company_id")
  fullName     String    @map("full_name") @db.VarChar(150)
  startDate    DateTime? @map("start_date") @db.Date // EMS employment start date for rule targeting (e.g., New Hires)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  // Foreign keys for TargetAudience matching rules locally
  departmentId Int? @map("department_id")
  jobTitleId   Int? @map("job_title_id")
  jobLevelId   Int? @map("job_level_id")

  // Internal LMS Relations
  company    Company     @relation(fields: [companyId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  jobTitle   JobTitle?   @relation(fields: [jobTitleId], references: [id])
  jobLevel   JobLevel?   @relation(fields: [jobLevelId], references: [id])

  appUsers                   AppUser[]
  enrollments                Enrollment[]
  courses                    Course[]
  ownedCourses               Course[]                    @relation("CourseOwner")
  manualCertificateReceived  Certificate[]               @relation("CertificateManualRecipient")
  courseInstructors          CourseInstructor[]
  employeeSkillAssessments   EmployeeSkillAssessment[]
  bookmarks                  Bookmark[]
  learningPrograms           LearningProgram[]
  programEnrollments         ProgramEnrollment[]
  submissions                Submission[]
  certificateTemplateSigners CertificateTemplateSigner[]
  certificateVerifications   CertificateVerification[]
  externalCertificates       ExternalCertificate[]
  liveSessionInstructors     LiveSessionInstructor[]
  surveyResponses            SurveyResponse[]
  trainingNeedRequests       TrainingNeedRequest[]
  xpTransactions             XpTransaction[]
  employeeBadges             EmployeeBadge[]
  approvalWorkflowSteps      ApprovalWorkflowStep[]
  submissionPeerReviews      SubmissionPeerReview[]
  tnaEmployees               TnaEmployee[]
  leaderboardEntries         LeaderboardEntry[]
  employmentType             EmploymentType?             @relation(fields: [employmentTypeId], references: [id])
  employmentTypeId           Int?

  @@index([companyId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([jobLevelId])
  @@map("employee")
}

model AppUser {
  id           Int       @id
  companyId    Int       @map("company_id")
  employeeId   String?   @map("employee_id") @db.VarChar(20)
  email        String    @db.VarChar(150)
  roleId       Int?      @map("role_id") // FK to AppRole synced from EMS
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  lastSyncedAt DateTime? @map("last_synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company  Company   @relation(fields: [companyId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  role     AppRole?  @relation(fields: [roleId], references: [id])

  createdCourses              Course[]                    @relation("CourseCreatedBy")
  updatedCourses              Course[]                    @relation("CourseUpdatedBy")
  createdCourseContents       CourseContent[]             @relation("CourseContentCreatedBy")
  updatedCourseContents       CourseContent[]             @relation("CourseContentUpdatedBy")
  createdCourseVersions       CourseVersion[]             @relation("CourseVersionCreatedBy")
  updatedCourseVersions       CourseVersion[]             @relation("CourseVersionUpdatedBy")
  publishedCourseVersions     CourseVersion[]             @relation("CourseVersionPublishedBy")
  approvedCourseVersions      CourseVersion[]             @relation("CourseVersionApprovedBy")
  createdCourseCategories     CourseCategory[]            @relation("CourseCategoryCreatedBy")
  updatedCourseCategories     CourseCategory[]            @relation("CourseCategoryUpdatedBy")
  createdCourseTags           CourseTag[]                 @relation("CourseTagCreatedBy")
  updatedCourseTags           CourseTag[]                 @relation("CourseTagUpdatedBy")
  createdCourseFAQ            CourseFAQ[]                 @relation("CourseFAQCreatedBy")
  updatedCourseFAQ            CourseFAQ[]                 @relation("CourseFAQUpdatedBy")
  createdCourseAnnouncements  CourseAnnouncement[]        @relation("CourseAnnouncementCreatedBy")
  updatedCourseAnnouncements  CourseAnnouncement[]        @relation("CourseAnnouncementUpdatedBy")
  manualCertificateIssued     Certificate[]               @relation("CertificateManualIssuedBy")
  createdCertTemplates        CertificateTemplate[]       @relation("CertTemplateCreatedBy")
  updatedCertTemplates        CertificateTemplate[]       @relation("CertTemplateUpdatedBy")
  createdLiveSessions         LiveSession[]               @relation("LiveSessionCreatedBy")
  updatedLiveSessions         LiveSession[]               @relation("LiveSessionUpdatedBy")
  createdXpRules              XpRule[]                    @relation("XpRuleCreatedBy")
  updatedXpRules              XpRule[]                    @relation("XpRuleUpdatedBy")
  createdAssessments          Assessment[]                @relation("AssessmentCreatedBy")
  updatedAssessments          Assessment[]                @relation("AssessmentUpdatedBy")
  createdQuestionBanks        QuestionBank[]              @relation("QuestionBankCreator")
  updatedQuestionBanks        QuestionBank[]              @relation("QuestionBankUpdater")
  gradedAttempts              AssessmentAttempt[]         @relation("GradedBy")
  createdPrograms             LearningProgram[]           @relation("ProgramCreatedBy")
  updatedPrograms             LearningProgram[]           @relation("ProgramUpdatedBy")
  assignedEnrollments         Enrollment[]                @relation("EnrollmentAssignedBy")
  approvedEnrollments         Enrollment[]                @relation("EnrollmentApprovedBy")
  enrollmentRuleCreator       EnrollmentRule[]            @relation("EnrollmentRuleCreator")
  enrollmentRuleUpdater       EnrollmentRule[]            @relation("EnrollmentRuleUpdater")
  awardedBadges               EmployeeBadge[]             @relation("BadgeAwardedBy")
  revokedBadges               EmployeeBadge[]             @relation("BadgeRevokedBy")
  createdSurveys              Survey[]                    @relation("SurveyCreatedBy")
  updatedSurveys              Survey[]                    @relation("SurveyUpdatedBy")
  createdApprovalWorkflows    ApprovalWorkflow[]          @relation("ApprovalWorkflowCreator")
  updatedApprovalWorkflows    ApprovalWorkflow[]          @relation("ApprovalWorkflowUpdater")
  createdProgramCategory      ProgramCategory[]           @relation("ProgramCategoryCreator")
  updatedProgramCategory      ProgramCategory[]           @relation("ProgramCategoryUpdater")
  createdCourseTemplate       CourseTemplate[]            @relation("CourseTemplateCreator")
  updatedCourseTemplate       CourseTemplate[]            @relation("CourseTemplateUpdater")
  createdProgramTemplate      ProgramTemplate[]           @relation("ProgramTemplateCreator")
  updatedProgramTemplate      ProgramTemplate[]           @relation("ProgramTemplateUpdater")
  createdAssessmentTemplate   AssessmentTemplate[]        @relation("AssessmentTemplateCreator")
  updatedAssessmentTemplate   AssessmentTemplate[]        @relation("AssessmentTemplateUpdater")
  createdNotificationTemplate NotificationTemplate[]      @relation("NotificationTemplateCreator")
  updatedNotificationTemplate NotificationTemplate[]      @relation("NotificationTemplateUpdater")
  createdLearningPathTemplate LearningPathTemplate[]      @relation("LearningPathTemplateCreator")
  updatedLearningPathTemplate LearningPathTemplate[]      @relation("LearningPathTemplateUpdater")
  createdSurveyTemplate       SurveyTemplate[]            @relation("SurveyTemplateCreator")
  updatedSurveyTemplate       SurveyTemplate[]            @relation("SurveyTemplateUpdater")
  createdAudienceGroup        AudienceGroup[]             @relation("AudienceGroupCreatedBy")
  updatedAudienceGroup        AudienceGroup[]             @relation("AudienceGroupUpdatedBy")
  submittedApprovalInstances  ApprovalWorkflowInstance[]  @relation("ApprovalInstanceSubmittedBy")
  approvalDecisions           ApprovalDecision[]          @relation("ApprovalDecisionMadeBy")
  courseInstructors           CourseInstructor[]
  employeeSkillAssessments    EmployeeSkillAssessment[]
  storedFiles                 StoredFile[]
  courseReviews               CourseReview[]
  programEnrollments          ProgramEnrollment[]
  enrollmentActivityLogs      EnrollmentActivityLog[]
  questions                   Question[]
  questionVersions            QuestionVersion[]
  assessmentAnswers           AssessmentAnswer[]
  submissions                 Submission[]
  effectivenessWeightConfigs  EffectivenessWeightConfig[]
  systemSettings              SystemSetting[]
  liveSessionInstructors      LiveSessionInstructor[]

  @@index([companyId])
  @@index([roleId])
  @@map("app_user")
}

model Department {
  id           Int       @id // Received directly from EMS
  companyId    Int       @map("company_id")
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  company              Company               @relation(fields: [companyId], references: [id])
  employees            Employee[]
  trainingNeedRequests TrainingNeedRequest[]
  audienceGroupRules   AudienceGroupRule[]
  targetAudiences      TargetAudience[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("department")
}

model JobTitle {
  id           Int       @id // Received directly from EMS
  companyId    Int       @map("company_id")
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  company              Company               @relation(fields: [companyId], references: [id])
  employees            Employee[]
  trainingNeedRequests TrainingNeedRequest[]
  audienceGroupRules   AudienceGroupRule[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("job_title")
}

model JobLevel {
  id           Int       @id // Received directly from EMS
  companyId    Int       @map("company_id")
  name         String    @db.VarChar(150)
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  company            Company             @relation(fields: [companyId], references: [id])
  employees          Employee[]
  audienceGroupRules AudienceGroupRule[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("job_level")
}

model AppRole {
  id           Int       @id // Received directly from EMS
  companyId    Int       @map("company_id")
  name         String    @db.VarChar(100)
  description  String?
  isActive     Boolean   @default(true) @map("is_active")
  lastSyncedAt DateTime? @map("last_synced_at")

  company               Company                @relation(fields: [companyId], references: [id])
  appUsers              AppUser[]
  lmsPermissions        LmsRolePermission[]
  audienceGroupRules    AudienceGroupRule[]
  targetAudiences       TargetAudience[]
  approvalWorkflowSteps ApprovalWorkflowStep[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("app_role")
}

// This model is for LMS-specific permissions not stored in EMS database
model LmsPermission {
  id          Int     @id @default(autoincrement())
  companyId   Int
  code        String  @db.VarChar(100) // e.g. "course.create", "course.publish", "tna.approve_level_1"
  description String?
  module      String  @db.VarChar(50) // groups by feature area: "course", "tna", "assessment", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company             @relation(fields: [companyId], references: [id])
  rolePermissions LmsRolePermission[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([module])
  @@map("lms_permissions")
}

model LmsRolePermission {
  id           Int @id @default(autoincrement())
  companyId    Int
  appRoleId    Int
  permissionId Int

  createdAt DateTime @default(now())

  company    Company       @relation(fields: [companyId], references: [id])
  appRole    AppRole       @relation(fields: [appRoleId], references: [id])
  permission LmsPermission @relation(fields: [permissionId], references: [id])

  @@unique([appRoleId, permissionId])
  @@index([companyId])
  @@map("lms_role_permissions")
}

///////////////////////////////////////////////////////////
// SHARED SCHEMAS
///////////////////////////////////////////////////////////
model StoredFile {
  id              Int  @id @default(autoincrement())
  companyId       Int
  courseContentId Int?
  submissionId    Int?

  fileTypeId       Int?
  originalFileName String  @db.VarChar(255)
  storedFileName   String  @db.VarChar(255)
  mimeType         String  @db.VarChar(100)
  fileExtension    String? @db.VarChar(20)
  fileSizeBytes    BigInt

  checksum        String?
  storageProvider String? @db.VarChar(50)
  bucket          String? @db.VarChar(255)
  objectKey       String? @db.VarChar(1000)
  region          String? @db.VarChar(100)

  version  Int     @default(1)
  isActive Boolean @default(true)

  uploadedBy Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company        Company          @relation(fields: [companyId], references: [id])
  courseContent  CourseContent?   @relation(fields: [courseContentId], references: [id])
  submission     Submission?      @relation(fields: [submissionId], references: [id])
  fileType       ContentFileType? @relation(fields: [fileTypeId], references: [id])
  uploadedByUser AppUser?         @relation(fields: [uploadedBy], references: [id])

  @@index([companyId])
  @@index([courseContentId])
  @@index([submissionId])
  @@index([fileTypeId])
  @@map("stored_files")
}

model Submission {
  id              Int  @id @default(autoincrement())
  companyId       Int
  courseContentId Int?
  programTaskId   Int?

  enrollmentId Int?
  employeeId   String @db.VarChar(20)

  submissionNo   Int                @default(1)
  submissionType TaskSubmissionType
  status         TaskStatus

  textAnswer    String? @db.Text
  submissionUrl String?

  dueDate       DateTime?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewedBy    Int?
  score         Decimal?  @db.Decimal(5, 2)
  reviewComment String?   @db.Text

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company        Company        @relation(fields: [companyId], references: [id])
  courseContent  CourseContent? @relation(fields: [courseContentId], references: [id])
  programTask    ProgramTask?   @relation(fields: [programTaskId], references: [id])
  enrollment     Enrollment?    @relation(fields: [enrollmentId], references: [id])
  employee       Employee       @relation(fields: [employeeId], references: [id])
  reviewedByUser AppUser?       @relation(fields: [reviewedBy], references: [id])

  peerReviews SubmissionPeerReview[]
  files       StoredFile[]

  @@unique([courseContentId, programTaskId, employeeId, submissionNo])
  @@index([companyId])
  @@index([courseContentId])
  @@index([programTaskId])
  @@index([enrollmentId])
  @@map("submissions")
}

model SubmissionPeerReview {
  id                 Int    @id @default(autoincrement())
  companyId          Int
  submissionId       Int
  reviewerEmployeeId String @db.VarChar(20)

  reviewText String?  @db.Text
  rating     Int?
  reviewedAt DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
  reviewer   Employee   @relation(fields: [reviewerEmployeeId], references: [id])

  @@unique([submissionId, reviewerEmployeeId])
  @@index([companyId])
  @@map("submission_peer_reviews")
}

model EmploymentType {
  id        Int     @id @default(autoincrement())
  companyId Int     @map("company_id")
  code      String  @db.VarChar(50) // Unique canonical key (e.g. "FULL_TIME", "CONTRACT")
  name      String  @db.VarChar(100) // Display label (e.g. "Full-Time Employee")
  isActive  Boolean @default(true) @map("is_active")

  // Relations
  employees            Employee[]
  rules                AudienceGroupRule[]
  trainingNeedRequests TrainingNeedRequest[]

  @@unique([companyId, code])
  @@map("employment_types")
}

// One or more rules per audience.
// Rules are simple conditions (e.g., Department = Finance).
// External logic can handle dynamic criteria (e.g., hire date).
// Extensible without modifying the core model.
model AudienceGroupRule {
  id              Int @id @default(autoincrement())
  companyId       Int
  audienceGroupId Int

  departmentId Int?
  appRoleId    Int?
  jobTitleId   Int?
  jobLevelId   Int?

  employmentTypeId Int?
  hireWithinDays   Int?

  // Defines whether this rule row is an addition (AND/OR) or an exclusion
  operator    RuleOperator @default(OR)
  isExclusion Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company        Company         @relation(fields: [companyId], references: [id])
  audienceGroup  AudienceGroup   @relation(fields: [audienceGroupId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  appRole        AppRole?        @relation(fields: [appRoleId], references: [id], onDelete: SetNull)
  jobTitle       JobTitle?       @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  jobLevel       JobLevel?       @relation(fields: [jobLevelId], references: [id], onDelete: SetNull)
  employmentType EmploymentType? @relation(fields: [employmentTypeId], references: [id])

  @@index([companyId])
  @@index([audienceGroupId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([jobLevelId])
  @@index([appRoleId])
  @@map("audience_group_rules")
}

// Named groups of employees defined by logic in AudienceGroupRule.
model AudienceGroup {
  id          Int     @id @default(autoincrement())
  companyId   Int
  name        String  @db.VarChar(100)
  description String? @db.Text

  isActive Boolean @default(true)

  createdBy Int
  updatedBy Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser AppUser  @relation("AudienceGroupCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  updatedByUser AppUser? @relation("AudienceGroupUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  rules           AudienceGroupRule[]
  targetAudiences TargetAudience[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("audience_groups")
}

// Clean junction model linking entities (Courses, Programs, etc.) to AudienceGroups.
model TargetAudience {
  id        Int @id @default(autoincrement())
  companyId Int

  // Owner
  entityType TargetAudienceEntityType
  entityId   Int

  // Reference to the reusable target group
  audienceGroupId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audienceGroup        AudienceGroup         @relation(fields: [audienceGroupId], references: [id], onDelete: Cascade)
  enrollmentRules      EnrollmentRule[]
  trainingNeedRequests TrainingNeedRequest[]
  tnaRecommendations   TnaRecommendation[]
  xpRules              XpRule[]
  badgeRules           BadgeRule[]
  leaderboards         Leaderboard[]
  department           Department?           @relation(fields: [departmentId], references: [id])
  departmentId         Int?
  appRole              AppRole?              @relation(fields: [appRoleId], references: [id])
  appRoleId            Int?

  @@unique([entityType, entityId, audienceGroupId]) // Prevents attaching the same group twice
  @@index([companyId])
  @@index([entityType, entityId])
  @@index([audienceGroupId])
  @@map("target_audiences")
}

///////////////////////////////////////////////////////////
// COURSE MANAGEMENT
///////////////////////////////////////////////////////////

model Course {
  id                 Int      @id @default(autoincrement())
  companyId          Int
  code               String?  @db.VarChar(50)
  title              String   @db.VarChar(255)
  description        String?  @db.Text
  thumbnailUrl       String?
  shortSummary       String?  @db.VarChar(150)
  categoryId         Int
  language           String?  @db.VarChar(20)
  learningObjectives String[]
  estimatedHours     Decimal?
  keywords           String[]

  // Learner-facing point of contact for questions about this course.
  // Distinct from createdBy (who authored it) and CourseInstructor
  // (version-scoped, can be multiple people).
  contactEmployeeId String? @db.VarChar(20)
  ownerEmployeeId   String? @db.VarChar(20)

  // PUBLIC = no visibility restriction WITHIN this company; still
  // scoped by companyId like every other table, not cross-tenant.
  visibility       VisibilityType   @default(COMPANY)
  enrollmentPolicy EnrollmentPolicy @default(OPEN)

  // Coarse container-level flag only. Authoritative workflow state is
  // CourseVersion.status + CourseVersion.approvalStatus.
  status            ContentLifecycleStatus @default(DRAFT)
  isTemplate        Boolean                @default(false)
  sourceTemplateId  Int?
  createdBy         Int
  updatedBy         Int?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?
  company           Company                @relation(fields: [companyId], references: [id])
  category          CourseCategory         @relation(fields: [categoryId], references: [id])
  contactEmployee   Employee?              @relation(fields: [contactEmployeeId], references: [id])
  ownerEmployee     Employee?              @relation("CourseOwner", fields: [ownerEmployeeId], references: [id])
  createdByUser     AppUser                @relation("CourseCreatedBy", fields: [createdBy], references: [id])
  updatedByUser     AppUser?               @relation("CourseUpdatedBy", fields: [updatedBy], references: [id])
  sourceTemplate    Course?                @relation("TemplateInstances", fields: [sourceTemplateId], references: [id])
  templateInstances Course[]               @relation("TemplateInstances")
  versions          CourseVersion[]
  bookmarks         Bookmark[]
  reviews           CourseReview[]
  prerequisites     CoursePrerequisite[]   @relation("CoursePrerequisites")
  requiredBy        CoursePrerequisite[]   @relation("RequiredCourses")
  skills            CourseSkill[]
  tags              CourseTagMapping[]
  courseFAQs        CourseFAQ[]
  relatedFrom       RelatedCourse[]        @relation("CourseRelations")
  relatedTo         RelatedCourse[]        @relation("RelatedTo")

  @@unique([companyId, code])
  @@unique([companyId, categoryId, title])
  @@index([companyId])
  @@index([categoryId])
  @@index([status])
  @@index([companyId, status])
  @@index([visibility])
  @@map("courses")
}

model DifficultyLevel {
  id        Int  @id @default(autoincrement())
  companyId Int?

  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String? @db.Text

  displayOrder Int @default(0)

  color String? @db.VarChar(20)
  icon  String? @db.VarChar(100)

  isSystem Boolean @default(false) // ADDED — protects platform-default rows (companyId=null) from being edited/deleted by a company admin, consistent with AssessmentType/GradingMethod/QuestionType/FundingType/TrainingFormat
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id])

  courseVersions       CourseVersion[]
  assessmentBlueprints AssessmentBlueprint[]
  questions            Question[]
  courseTemplates      CourseTemplate[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("difficulty_levels")
}

model CourseVersion {
  id        Int @id @default(autoincrement())
  companyId Int
  courseId  Int

  // Version fields - integer-based for proper sorting
  majorVersion      Int     @default(1) // e.g. 1, 2, 3
  minorVersion      Int     @default(0) // e.g. 0, 1, 2
  versionLabel      String? @db.VarChar(50) // cosmetic only: "beta", "rc1", "hotfix"
  changeLog         String? //Very useful for version history.
  difficultyLevelId Int

  // Course configuration — authoritative for enrollability.
  // Course.status is informational/catalog-filtering only; never gate
  // enrollment on Course.status alone — always check here.
  status         VersionStatus  @default(DRAFT)
  approvalStatus ApprovalStatus @default(PENDING)

  estimatedDurationMinutes Int?
  requiredAssessmentScore  Decimal  @db.Decimal(5, 2)
  completionThreshold      Decimal  @db.Decimal(5, 2)
  certificateRequired      Boolean  @default(true)
  attendanceRequired       Boolean  @default(false)
  minimumAttendance        Decimal? @db.Decimal(5, 2)
  allowDownload            Boolean
  capacity                 Int?
  isCurrent                Boolean  @default(false) //Makes fetching latest version easy.
  previewAvailable         Boolean

  // Publishing metadata
  publishDate DateTime?
  publishedBy Int?

  // Approval metadata — was missing; approvalStatus had no record of
  // who made the decision or when.
  approvedBy Int?
  approvedAt DateTime?

  // Audit fields
  createdBy Int
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  difficultyLevel     DifficultyLevel       @relation(fields: [difficultyLevelId], references: [id])
  company             Company               @relation(fields: [companyId], references: [id])
  course              Course                @relation(fields: [courseId], references: [id])
  createdByUser       AppUser               @relation("CourseVersionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser       AppUser?              @relation("CourseVersionUpdatedBy", fields: [updatedBy], references: [id])
  publishedByUser     AppUser?              @relation("CourseVersionPublishedBy", fields: [publishedBy], references: [id])
  approvedByUser      AppUser?              @relation("CourseVersionApprovedBy", fields: [approvedBy], references: [id])
  chapters            CourseChapter[]
  instructors         CourseInstructor[]
  enrollments         Enrollment[]
  assessments         Assessment[]
  certificateTemplate CertificateTemplate[]
  liveSessions        LiveSession[]         @relation("CourseVersionLiveSessions")
  surveys             Survey[]
  announcements       CourseAnnouncement[]
  programCourses      ProgramCourse[]
  tnaRecommendations  TnaRecommendation[]
  enrollmentRules     EnrollmentRule[]      @relation("EnrollmentRuleCourseVersion")
  //courseRelatedTo     RelatedCourse[]    @relation("RelatedTo")

  approvalInstances ApprovalWorkflowInstance[]
  xpRules           XpRule[]
  programTasks      ProgramTask[]
  courseFAQs        CourseFAQ[]

  @@unique([courseId, majorVersion, minorVersion])
  // One course can have only one version per major.minor combination
  @@index([difficultyLevelId])
  @@index([companyId])
  @@index([courseId, status])
  @@index([publishDate])
  @@map("course_versions")
}

model CourseTag {
  id            Int                @id @default(autoincrement())
  companyId     Int
  name          String             @db.VarChar(100)
  slug          String             @db.VarChar(120)
  color         String?            @db.VarChar(20)
  description   String?            @db.Text
  isActive      Boolean            @default(true)
  createdBy     Int?
  updatedBy     Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  company       Company            @relation(fields: [companyId], references: [id])
  createdByUser AppUser?           @relation("CourseTagCreatedBy", fields: [createdBy], references: [id])
  updatedByUser AppUser?           @relation("CourseTagUpdatedBy", fields: [updatedBy], references: [id])
  courses       CourseTagMapping[]

  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([isActive])
  @@map("course_tags")
}

model CourseTagMapping {
  id        Int       @id @default(autoincrement())
  companyId Int
  courseId  Int
  tagId     Int
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])
  tag       CourseTag @relation(fields: [tagId], references: [id])

  @@unique([courseId, tagId])
  @@index([companyId])
  @@map("course_tag_mappings")
}

model CourseAnnouncement {
  id               Int           @id @default(autoincrement())
  companyId        Int
  courseVersionId  Int
  title            String        @db.VarChar(255)
  message          String        @db.Text
  publishAt        DateTime?
  expiresAt        DateTime?
  isPinned         Boolean       @default(false)
  sendNotification Boolean       @default(true)
  createdBy        Int
  updatedBy        Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  company          Company       @relation(fields: [companyId], references: [id])
  courseVersion    CourseVersion @relation(fields: [courseVersionId], references: [id])
  createdByUser    AppUser       @relation("CourseAnnouncementCreatedBy", fields: [createdBy], references: [id])
  updatedByUser    AppUser?      @relation("CourseAnnouncementUpdatedBy", fields: [updatedBy], references: [id])

  @@index([companyId])
  @@index([courseVersionId])
  @@index([publishAt])
  @@index([expiresAt])
  @@map("course_announcements")
}

model CourseCategory {
  id        Int @id @default(autoincrement())
  companyId Int

  // Core fields
  name        String  @db.VarChar(100)
  description String? @db.Text
  slug        String  @db.VarChar(120)

  // Display & Organization
  color        String? @db.VarChar(20)
  icon         String? @db.VarChar(50)
  displayOrder Int     @default(0)

  // Hierarchy support. NOTE: nothing at the DB level prevents a cycle
  // (A -> B -> A) — must be checked in application logic on every
  // write that sets parentId, or category-tree UIs risk an infinite loop.
  parentId Int?
  parent   CourseCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children CourseCategory[] @relation("CategoryHierarchy")

  // Status & Visibility — independent flags by design. isActive=false
  // does NOT automatically imply isVisible=false; check both explicitly
  // wherever category visibility is decided.
  isActive  Boolean @default(true)
  isVisible Boolean @default(true)

  // Metadata
  createdBy Int?
  updatedBy Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  company         Company          @relation(fields: [companyId], references: [id])
  createdByUser   AppUser?         @relation("CourseCategoryCreatedBy", fields: [createdBy], references: [id])
  updatedByUser   AppUser?         @relation("CourseCategoryUpdatedBy", fields: [updatedBy], references: [id])
  courses         Course[]
  courseTemplates CourseTemplate[]
  questionBanks   QuestionBank[]

  // Constraints & Indexes
  @@unique([companyId, name])
  @@unique([companyId, slug])
  @@index([companyId])
  @@index([parentId])
  @@index([isActive, isVisible])
  @@index([displayOrder])
  @@map("course_categories")
}

model InstructorRole {
  id          Int                @id @default(autoincrement())
  companyId   Int
  name        String             @db.VarChar(100) // e.g. TEACHER, TRAINER, SKILL_COACH, REVIEWER, EXAMINER
  description String?            @db.Text
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  company     Company            @relation(fields: [companyId], references: [id])
  assignments CourseInstructor[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("instructor_roles")
}

model CourseInstructor {
  id              Int @id @default(autoincrement())
  companyId       Int
  courseVersionId Int

  // Internal instructor (Employee) OR external instructor (AppUser) —
  // exactly one of these two must be set, never both, never neither.
  // Not enforceable by Prisma/Postgres directly; must be validated in
  // application logic on every write to this table.
  employeeId String? @db.VarChar(20)
  appUserId  Int?

  roleId     Int
  isPrimary  Boolean   @default(true)
  assignedAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  company       Company        @relation(fields: [companyId], references: [id])
  courseVersion CourseVersion  @relation(fields: [courseVersionId], references: [id])
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  appUser       AppUser?       @relation(fields: [appUserId], references: [id])
  role          InstructorRole @relation(fields: [roleId], references: [id])

  @@index([companyId])
  @@index([courseVersionId])
  @@index([employeeId])
  @@index([appUserId])
  @@map("course_instructors")
}

model CourseSkill {
  id        Int       @id @default(autoincrement())
  companyId Int
  courseId  Int
  skillId   Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  company   Company   @relation(fields: [companyId], references: [id])
  course    Course    @relation(fields: [courseId], references: [id])
  skill     Skill     @relation(fields: [skillId], references: [id])

  @@unique([courseId, skillId])
  @@map("course_skills")
}

model Skill {
  id                      Int                       @id @default(autoincrement())
  companyId               Int
  name                    String                    @db.VarChar(150)
  description             String?
  isActive                Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  company                 Company                   @relation(fields: [companyId], references: [id])
  courses                 CourseSkill[]
  employeeAssessments     EmployeeSkillAssessment[]
  trainingNeedSkills      TrainingNeedSkill[]
  tnaRecommendationSkills TnaRecommendationSkill[]

  @@unique([companyId, name])
  @@map("skills")
}

model EmployeeSkillAssessment {
  id                    Int              @id @default(autoincrement())
  companyId             Int
  employeeId            String           @db.VarChar(20)
  skillId               Int
  completionId          Int // ties this measurement to a specific course completion event
  preScore              Decimal?         @db.Decimal(5, 2) // baseline, if measured
  postScore             Decimal          @db.Decimal(5, 2) // measured after completion
  improvementPercentage Decimal          @db.Decimal(5, 2) // e.g. "+34%" as shown in the Figma
  assessedAt            DateTime         @default(now())
  assessedBy            Int? // AppUser — null if system-calculated, set if a manager/reviewer scored it manually
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?
  company               Company          @relation(fields: [companyId], references: [id])
  employee              Employee         @relation(fields: [employeeId], references: [id])
  skill                 Skill            @relation(fields: [skillId], references: [id])
  completion            CourseCompletion @relation(fields: [completionId], references: [id])
  assessedByUser        AppUser?         @relation(fields: [assessedBy], references: [id])

  @@index([companyId])
  @@index([employeeId])
  @@index([skillId])
  @@index([completionId])
  @@map("employee_skill_assessments")
}

model CoursePrerequisite {
  id                   Int       @id @default(autoincrement())
  companyId            Int
  courseId             Int
  prerequisiteCourseId Int
  isMandatory          Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  company              Company   @relation(fields: [companyId], references: [id])
  course               Course    @relation("CoursePrerequisites", fields: [courseId], references: [id])
  prerequisite         Course    @relation("RequiredCourses", fields: [prerequisiteCourseId], references: [id])

  @@unique([courseId, prerequisiteCourseId])
  @@index([companyId])
  @@map("course_prerequisites")
}

model CourseChapter {
  id              Int @id @default(autoincrement())
  companyId       Int
  courseVersionId Int

  title            String                 @db.VarChar(255)
  description      String?                @db.Text
  displayOrder     Int
  estimatedMinutes Decimal?
  status           ContentLifecycleStatus @default(DRAFT)
  isRequired       Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  company          Company                @relation(fields: [companyId], references: [id])
  courseVersion    CourseVersion          @relation(fields: [courseVersionId], references: [id])
  contents         CourseContent[]
  prerequisites    ChapterPrerequisite[]  @relation("ChapterPrerequisites")
  requiredBy       ChapterPrerequisite[]  @relation("RequiredChapters")

  @@unique([courseVersionId, displayOrder])
  @@index([companyId])
  @@map("course_chapters")
}

model ChapterPrerequisite {
  id                    Int           @id @default(autoincrement())
  companyId             Int
  chapterId             Int
  prerequisiteChapterId Int
  isMandatory           Boolean       @default(true)
  createdAt             DateTime      @default(now())
  company               Company       @relation(fields: [companyId], references: [id])
  chapter               CourseChapter @relation("ChapterPrerequisites", fields: [chapterId], references: [id])
  prerequisite          CourseChapter @relation("RequiredChapters", fields: [prerequisiteChapterId], references: [id])

  @@unique([chapterId, prerequisiteChapterId])
  @@index([companyId])
  @@map("chapter_prerequisites")
}

model CourseContent {
  id Int @id @default(autoincrement())

  companyId     Int
  chapterId     Int
  contentTypeId Int

  // Common metadata
  title         String  @db.VarChar(255)
  description   String? @db.Text
  displayOrder  Int
  transcriptUrl String?
  thumbnailUrl  String?
  openInNewTab  Boolean @default(true)

  isRequired               Boolean  @default(true)
  estimatedDurationMinutes Int?
  completionThreshold      Decimal? @db.Decimal(5, 2)
  minimumTimeMinutes       Int?
  allowDownload            Boolean  @default(false)
  additionalLink           String?  @db.VarChar(500)

  // Optional metadata depending on ContentType

  maxSubmissions    Int?    @default(1)
  allowResubmission Boolean @default(false)

  requiresManagerApproval    Boolean @default(false) // Line manager
  requiresInstructorApproval Boolean @default(false) // Course instructor / owner
  peerReviewRequired         Boolean @default(false)

  pageCount         Int?
  externalUrl       String?            @db.VarChar(1000)
  scormLaunchUrl    String?            @db.VarChar(1000)
  scormTrackingMode ScormTrackingMode?

  createdBy Int
  updatedBy Int?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  company     Company       @relation(fields: [companyId], references: [id])
  chapter     CourseChapter @relation(fields: [chapterId], references: [id])
  contentType ContentType   @relation(fields: [contentTypeId], references: [id])

  creator AppUser  @relation("CourseContentCreatedBy", fields: [createdBy], references: [id])
  updater AppUser? @relation("CourseContentUpdatedBy", fields: [updatedBy], references: [id])

  files              StoredFile[]
  lessonProgress     LessonProgress[]
  learningProgresses LearningProgress[]
  assessments        Assessment[]
  programTasks       ProgramTask[]
  submissions        Submission[]

  @@unique([chapterId, displayOrder])
  @@index([companyId])
  @@map("course_contents")
}

model ContentType {
  id Int @id @default(autoincrement())

  slug        String          @unique
  name        String
  category    ContentCategory
  description String?
  icon        String?

  isActive Boolean @default(true)

